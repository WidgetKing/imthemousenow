# Built by imthemousenow's install.sh, which exports MOUSENOW_* from pkg/source.toml.
# pacman owns the binary, so uninstalling is `pacman -Rns wl-kbptr-omarchy`.
pkgname=wl-kbptr-omarchy
# Overwritten by pkgver() once the source is checked out.
pkgver=0.4.1
pkgrel=1
# The version scheme changed when the build moved from patch files to the
# fork, and the old one (0.4.1.r0854a51.p7...) sorts above the new
# (0.4.1.r184.g...). The epoch puts every fork build above every patch build,
# so moving over is an upgrade and not a downgrade pacman warns about.
epoch=1
pkgdesc="Control the mouse pointer with the keyboard on Wayland (Omarchy build)"
arch=(x86_64 aarch64)
url="${MOUSENOW_REPO:-https://github.com/WidgetKing/wl-kbptr}"
license=('GPL-3.0-or-later')
depends=(wayland libxkbcommon cairo)
makedepends=(git meson ninja wayland-protocols)
provides=(wl-kbptr)
conflicts=(wl-kbptr wl-kbptr-git)
# The exact commit install.sh resolved the branch to, not the branch: that
# commit is what the build id records, so the fork moving on between asking
# and cloning must not build something else under its name.
source=("wl-kbptr::git+${url}.git#commit=${MOUSENOW_COMMIT:?install.sh sets MOUSENOW_COMMIT}")
sha256sums=('SKIP')

if [[ ${MOUSENOW_OPENCV:-1} == 1 ]]; then
  depends+=(opencv pixman)
fi

# 0.4.1.r<commits>.g<hash>: the count makes pacman order one build after the
# next, and the hash makes `pacman -Q wl-kbptr-omarchy` say exactly which
# commit of the fork is installed.
pkgver() {
  cd wl-kbptr
  printf '0.4.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  local opencv=disabled
  [[ ${MOUSENOW_OPENCV:-1} == 1 ]] && opencv=enabled
  arch-meson wl-kbptr build -Dopencv=$opencv
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 wl-kbptr/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
