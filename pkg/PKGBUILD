# Built by imthemousenow's install.sh, which exports KBPTR_* from pkg/source.toml.
# pacman owns the binary, so uninstalling is `pacman -Rns wl-kbptr-omarchy`.
pkgname=wl-kbptr-omarchy
pkgver="${MOUSENOW_PKGVER:-0.4.1.r0854a51}"
pkgrel=1
pkgdesc="Control the mouse pointer with the keyboard on Wayland (Omarchy build)"
arch=(x86_64 aarch64)
url="https://github.com/moverest/wl-kbptr"
license=('GPL-3.0-or-later')
depends=(wayland libxkbcommon cairo)
makedepends=(git meson ninja wayland-protocols)
provides=(wl-kbptr)
conflicts=(wl-kbptr wl-kbptr-git)
source=("wl-kbptr::git+${url}.git#commit=${MOUSENOW_COMMIT}")
sha256sums=('SKIP')

if [[ ${MOUSENOW_OPENCV:-1} == 1 ]]; then
  depends+=(opencv pixman)
fi

build() {
  local opencv=disabled
  [[ ${MOUSENOW_OPENCV:-1} == 1 ]] && opencv=enabled
  arch-meson wl-kbptr build -Dopencv=$opencv
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 wl-kbptr/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
