# Built by imthemousenow's install.sh, which exports MOUSENOW_* from pkg/source.toml.
# pacman owns the binary, so uninstalling is `pacman -Rns wl-kbptr-omarchy`.
pkgname=wl-kbptr-omarchy
# The patch set is part of the version, because it is part of the binary: two
# builds of the same upstream commit with different patches are different
# programs, and `pacman -Q` has to be able to tell them apart. See pkg/patch-stamp.
pkgver="${MOUSENOW_PKGVER:-0.4.1.r${MOUSENOW_COMMIT:0:7}}.$("$startdir/patch-stamp" "$startdir")"
pkgrel=1
pkgdesc="Control the mouse pointer with the keyboard on Wayland (Omarchy build)"
arch=(x86_64 aarch64)
url="https://github.com/moverest/wl-kbptr"
license=('GPL-3.0-or-later')
depends=(wayland libxkbcommon cairo)
makedepends=(git meson ninja wayland-protocols)
provides=(wl-kbptr)
conflicts=(wl-kbptr wl-kbptr-git)
source=(
  "wl-kbptr::git+${url}.git#commit=${MOUSENOW_COMMIT}"
  0001-destroy-pending-frame-callback-before-teardown.patch
  0002-read-keys-from-a-channel-instead-of-the-keyboard.patch
)
# Every patch is listed above and applied below in that order; adding one is a
# single line here. Each patch's own header says what it does and whether it is
# headed upstream (0001 is a bug fix and should land there; 0002 is ours).
# One entry per source, so a new patch needs a 'SKIP' here too or makepkg refuses.
sha256sums=('SKIP' 'SKIP' 'SKIP')

if [[ ${MOUSENOW_OPENCV:-1} == 1 ]]; then
  depends+=(opencv pixman)
fi

prepare() {
  local p
  for p in "${source[@]}"; do
    [[ $p == *.patch ]] || continue
    patch -d wl-kbptr -Np1 -i "$srcdir/$p"
  done
}

build() {
  local opencv=disabled
  [[ ${MOUSENOW_OPENCV:-1} == 1 ]] && opencv=enabled
  arch-meson wl-kbptr build -Dopencv=$opencv
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 wl-kbptr/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
