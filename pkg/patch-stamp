#!/bin/bash
# Identify the patch set we apply to wl-kbptr, as a pkgver component.
#
# Printed as p<count>.<8 hex>. Both halves earn their place: the count orders
# one build after another for pacman, and the hash changes whenever any patch's
# bytes or filename change. That hash is the whole point -- it is what lets
# install.sh know a rebuild is due when the pinned commit has not moved, and
# what makes `pacman -Q wl-kbptr-omarchy` answer "which patch set is this
# user actually running", which is otherwise unanswerable.
#
# Called from two places that must agree -- pkg/PKGBUILD for pkgver, install.sh
# for the rebuild decision -- so the answer depends only on the directory
# given, which defaults to this script's own.
set -euo pipefail

dir="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# Sorted with LC_ALL=C and hashed with the names included: reordering, renaming
# or reflowing a patch all have to move the hash, or it is not a build id.
mapfile -t patches < <(cd "$dir" && LC_ALL=C ls -- *.patch 2>/dev/null || true)

if ((${#patches[@]} == 0)); then
  echo "p0.00000000"
  exit 0
fi

hash="$(
  cd "$dir"
  LC_ALL=C cat -- "${patches[@]}"
  printf '%s\n' "${patches[@]}"
)"
printf 'p%d.%s\n' "${#patches[@]}" "$(printf '%s' "$hash" | sha256sum | cut -c1-8)"
