#!/bin/bash
# omarchy:summary=Print one locale's string table, for a reader that is not bash
# omarchy:args=[TABLE]
#
# The bar widget is QML, running inside Omarchy's long-lived quickshell
# process, so it cannot call t() in bin/imthemousenow-lib.sh the way every
# other piece of this plugin does. It runs this instead -- one process when the
# panel opens, alongside the `imthemousenow-config env` it already runs -- and
# looks its labels up in what comes back.
#
# The alternative was for shell/Model.js to read locale/*.strings itself. That
# would have put a second .strings parser and, worse, a second answer to "which
# locale is this" in JavaScript, free to drift from _locale_name() here. One
# program decides both; this is how it tells anyone else.
#
# TABLE picks which file: none for locale/<code>.strings, `panel` for
# locale/<code>.panel.strings.
#
# English underneath, the running locale on top. The table that comes back is
# always complete: a locale nobody has translated yet reads as English, and a
# half-translated one reads as its own words where it has them and English
# everywhere else -- the same answer t() gets from the English written at each
# of its call sites, except that here there is nowhere else to get it.
#
# That is what lets the bar widget carry no fallbacks of its own (see
# shell/Panel.qml's str()): with English layered in here, a key this prints
# nothing for is a key that exists nowhere, which is a fault worth showing.
# Nothing prints only when locale/ itself is missing or unreadable, and that
# is a broken install rather than an untranslated desktop.
set -euo pipefail

# imthemousenow-locale.sh, not imthemousenow-lib.sh: sourcing the lib loads
# and validates the whole merged config, and this runs on every panel open to
# print words. See that file's header.
LIB_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}/bin"
[[ -f $LIB_DIR/imthemousenow-locale.sh ]] || LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=imthemousenow-locale.sh
source "$LIB_DIR/imthemousenow-locale.sh"

usage() {
  cat <<'EOF'
Usage: imthemousenow-strings [TABLE]

Print the running locale's string table as `key=value` lines, the value
quoted the way `imthemousenow-config env` quotes its own.

TABLE  panel  the bar widget's chrome (locale/<code>.panel.strings)
       (none) everything bash draws (locale/<code>.strings)

Options:
  --file        Print the path this would read, and exit.
  -h, --help    This.
EOF
}

table=""
print_path=0
while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --file) print_path=1 ;;
    panel | "") table="$1" ;;
    *) printf 'imthemousenow-strings: unknown table %q; try --help\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

file="$(strings_file "$table")"
if ((print_path)); then
  printf '%s\n' "$file"
  exit 0
fi

declare -A strings=()
# Both, in this order, and _strings_read only ever adds to the array: English
# first so every key exists, then the locale's own file over the top of it.
# Reading the same file twice when the locale IS English costs one pass over
# sixty lines and keeps the order below free of a special case.
_strings_read "$(strings_file_for en "$table")" strings
_strings_read "$file" strings

# Single-quoted, with an embedded quote written the long way round --
# shlex.quote()'s output for anything it will not leave bare, which is what
# `imthemousenow-config env` already emits and what unquote() in
# shell/Model.js already reads. Bash's own %q is a different dialect ($'...'
# among others); there is one unquoter on the other side and it speaks this
# one. Always quoted rather than bare-when-safe, so an empty string survives
# the trip as an empty string.
#
# Sorted, so two runs are diffable and a test can line the output up against
# the file it came from without caring about hash order.
# In one printf, with the quoting done by parameter expansion rather than a
# shquote function: this runs on every panel open, and a command substitution
# per key made a 5ms script into a 66ms one -- sixty-odd forks to quote sixty-
# odd strings. Long enough to see the panel paint English and then correct
# itself.
# An empty table prints nothing at all. With English layered in above, that
# means locale/ itself is missing or unreadable -- a broken install, which the
# caller is left to notice and say so. Guarded here because "${!strings[@]}"
# on an empty associative array still yields one empty line for printf.
((${#strings[@]})) || exit 0

out=""
while IFS= read -r key; do
  out+="$key='${strings[$key]//\'/\'\"\'\"\'}'"$'\n'
done < <(printf '%s\n' "${!strings[@]}" | sort)
printf '%s' "$out"
