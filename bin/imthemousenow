#!/bin/bash
# omarchy:summary=Move and click the pointer with the keyboard
# omarchy:args=[--mode grid|hints] [--scope window|monitor] [--action ...] [--lifetime ...]
# omarchy:examples=imthemousenow | imthemousenow --mode grid --scope monitor
#
# Every invocation is four independent choices:
#
#   MODE      grid | hints          how targets are presented
#   SCOPE     window | monitor      where the overlay is drawn
#   ACTION    left-click | right-click | move | drag
#   LIFETIME  single | continuous   one selection, or until Escape
#
# Unset choices come from [imthemousenow.defaults].
#
# This launches an overlay and keeps it up. Changing one that is already up is
# imthemousenow-steer's job -- the overlay's own keys run that, not this.

set -euo pipefail

LIB_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}/bin"
[[ -f $LIB_DIR/imthemousenow-lib.sh ]] || LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=imthemousenow-lib.sh
source "$LIB_DIR/imthemousenow-lib.sh"
# shellcheck source=imthemousenow-session.sh
source "$LIB_DIR/imthemousenow-session.sh"

USER_DIR="$HOME/.config/omarchy/imthemousenow"
STATE_DIR="$HOME/.local/state/imthemousenow"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow.lock"
STEER_CMD="$LIB_DIR/imthemousenow-steer"
[[ -x $STEER_CMD ]] || STEER_CMD="imthemousenow-steer"
SUBMAP="imthemousenow"
# EXPERIMENTAL, chosen by popups.keep_open: the same overlay with its keys
# coming from compositor bindings, so it never takes keyboard focus and the
# popup it is drawn over lives on. See hypr/imthemousenow.lua.
SUBMAP_POPUPS="imthemousenow-popups"
KEY_CHANNEL="$SESSION_DIR/keys"
# Mirrors RELAY_KEYS in hypr/imthemousenow.lua; keep them in step.
RELAY_KEYS=(comma Escape BackSpace Return space {a..z})

list_modes() {
  local name
  for name in $(setting valid.mode); do
    printf "              %-8s %s\n" "$name" "$(setting "mode.$name.description")"
  done
}

has_opencv() {
  wl-kbptr --version 2>&1 | grep -qi opencv
}

# Whether the installed wl-kbptr is one that can be fed keys through a file.
# It is not a flag or a version -- the patch reads an environment variable --
# so the binary is asked the only way it can answer: the name is in it or it
# is not. A stock wl-kbptr would ignore the variable, take keyboard focus as
# usual, and leave every label key bound to a relay it never reads; better to
# stay on the ordinary submap than to hand over a keyboard nothing listens to.
has_key_channel() {
  local binary
  binary="$(command -v wl-kbptr)" || return 1
  grep -qa WL_KBPTR_KEY_CHANNEL "$binary"
}

# Whether the installed wl-kbptr is one that can hold a button down across a
# path. Asked the same way has_key_channel asks its question, and for the same
# reason: --drag is ours, not a version or a flag upstream would report, so the
# binary is asked the only way it can answer. A stock wl-kbptr would reject the
# argument and exit non-zero AFTER both overlays had been aimed, which is the
# worst moment to find out; better to refuse the chord up front.
has_drag() {
  local binary
  binary="$(command -v wl-kbptr)" || return 1
  grep -qa -- --drag "$binary"
}

# Focused monitor as: name<TAB>x<TAB>y<TAB>w<TAB>h
# $1 must be one of the remaining arguments.
expect_one_of() {
  local value="$1" label="$2"
  shift 2
  local candidate
  for candidate in "$@"; do
    [[ $value == "$candidate" ]] && return 0
  done
  die "unknown $label '$value'; expected one of: $*"
}

# Some of our submap binds do not survive an overlay: when wl-kbptr exits,
# Hyprland drops exactly the LEFT/RIGHT/UP/DOWN binds -- reproducibly, with
# wl-kbptr launched by hand and no submap involved, while SEMICOLON and the
# digits in the same submap survive untouched. So they are re-asserted before
# every launch. `hl.define_submap` appends to a submap that already exists, and
# a bind re-asserted while present is DUPLICATED rather than replaced, so only
# the missing ones may be sent.
#
# The panic key and F5 are in here for a different reason: both must be
# present, and the cost of checking is the same jq call the arrows already
# need. A bind that is already there is skipped, so listing one that does
# survive costs nothing.
# key:command:description -- the description keeps a re-asserted bind looking
# the same as the one hypr/imthemousenow.lua registered at startup.
SUBMAP_KEYS=(
  "LEFT:imthemousenow-steer arrow l:Pointer: previous workspace, or move the window left"
  "RIGHT:imthemousenow-steer arrow r:Pointer: next workspace, or move the window right"
  "UP:imthemousenow-steer arrow u:Pointer: previous monitor, or move the window up"
  "DOWN:imthemousenow-steer arrow d:Pointer: next monitor, or move the window down"
  "TAB:imthemousenow-steer swap:Pointer: swap this window with one you pick"
  "apostrophe:imthemousenow-steer action drag:Pointer: pick something up, then say where to drop it"
  "F5:imthemousenow-steer refresh:Pointer: rebuild the overlay against the screen as it is now"
  "CTRL + ALT + DELETE:imthemousenow-panic:Pointer: close the overlay and all windows"
)

ensure_submap_binds() {
  local present body="" entry bind key cmd description
  present="$(hyprctl -j binds | jq -r --arg s "$SUBMAP" \
    '[.[] | select(.submap == $s) | .key] | join(" ")' 2>/dev/null || true)"
  # The relay binds are the whole keyboard in popup-safe mode, so a dropped
  # one is a label that cannot be typed. They are re-asserted by name through
  # the function hypr/imthemousenow.lua exposes, rather than rebuilt here.
  if [[ $SUBMAP == "$SUBMAP_POPUPS" ]]; then
    local relay
    for relay in "${RELAY_KEYS[@]}"; do
      [[ " $present " == *" $relay "* ]] && continue
      body+="imthemousenow_relay_bind(\"$relay\")"$'\n'
    done
  fi

  for entry in "${SUBMAP_KEYS[@]}"; do
    bind="${entry%%:*}"
    entry="${entry#*:}"
    cmd="${entry%%:*}"
    description="${entry#*:}"
    # hyprctl reports the key alone; the bind we send carries its modifiers.
    key="${bind##* }"
    [[ " $present " == *" $key "* ]] && continue
    body+="hl.bind(\"$bind\", hl.dsp.exec_cmd(\"$cmd\"),"
    body+=" { description = \"$description\" })"$'\n'
  done
  [[ -n $body ]] || return 0
  hyprctl eval "hl.define_submap(\"$SUBMAP\", function()
$body
end)" >/dev/null 2>&1 || true
}

main() {
  local mode="" scope="" action="" lifetime="" dry_run=0 extra_opts=()

  while (($#)); do
    case "$1" in
      -h | --help)
        cat <<EOF
Usage: imthemousenow [--mode M] [--scope S] [--action A] [--lifetime L] [-- <wl-kbptr args>]

Every invocation is four independent choices. Anything you leave out comes
from [imthemousenow.defaults] in the config.

  --mode      grid | hints        how targets are presented
$(list_modes)
  --scope     window | monitor    the focused window, or the whole monitor
  --action    left-click | right-click | move | drag
  --lifetime  single | continuous one selection, or reopen until Escape

Inside the overlay, at the narrowing-down step, the home row picks a sub-area
and three keys commit it:  g = left click,  ; = right click,  b = middle click.
So a right click is always one keypress away, whatever --action says.

Three keys switch ACTION for the whole overlay, at any point before you commit:

  ;   right click, tinted red      press again to go back
  :   move (no click), tinted      press again to go back
  '   drag, tinted yellow          press again to go back

Any of them is a one-off: after it lands, ACTION returns to what the chord
asked for, even in a continuous lifetime.

A drag asks twice: once for the thing to pick up, once for where it goes. The
first pass only moves the pointer -- nothing is pressed until both ends are
known -- so `;`, `:`, `'` and Escape all abandon one halfway and leave nothing
held. The drop pass covers the monitor the drag picked up on, and the pointer
takes action.drag.duration_ms to travel, because a client reads drag-and-drop
out of the motion events under a held button and one jump is not enough of
them.

  F5   rebuild the overlay against the screen as it is now
  Tab  in --scope window: swap this window with one you pick

An overlay is measured once, when it opens. Press F5 when the screen has moved
underneath it -- a page scrolled, a window resized, a dialog opened -- and the
labels are re-derived from what is on screen now.

Tab opens a picker with one label per window (that is --mode windows, which you
can also ask for directly). Picking one swaps it with the window the overlay is
on, and the overlay comes back on that window in its new place.

The digits and the arrows move what is under the overlay, and what that is
depends on SCOPE. In --scope monitor the overlay is a whole screen, so they
move the screen:

  1..9          switch to that workspace
  Left / Right  previous / next workspace on this monitor
  Up / Down     move the overlay to the previous / next monitor

In --scope window the overlay is one window, so they move that window --
the same thing SUPER + an arrow and SUPER + SHIFT + a digit do outside it:

  1..9          send the window to that workspace, and follow it there
  arrows        move the window left / right / up / down

Either way the overlay is rebuilt around where things ended up, so you keep
aiming without leaving it.

Options:
  --list        List modes, one per line.
  -n, --dry-run Print the wl-kbptr command that would run, then exit.
  -R, --repeat  Alias for --lifetime continuous.
  --stop        Close any running overlay. Bind this if you ever get stuck.
  --            Pass everything after this straight to wl-kbptr.
EOF
        exit 0
        ;;
      --stop)
        # Kept here because it is the one documented way out of a stuck
        # overlay and people have it bound; the work itself is steering.
        exec "$STEER_CMD" stop
        ;;
      --mode) mode="${2:-}"; [[ -n $mode ]] || die "--mode needs a value"; shift 2 ;;
      --mode=*) mode="${1#*=}"; shift ;;
      --scope) scope="${2:-}"; [[ -n $scope ]] || die "--scope needs a value"; shift 2 ;;
      --scope=*) scope="${1#*=}"; shift ;;
      --action) action="${2:-}"; [[ -n $action ]] || die "--action needs a value"; shift 2 ;;
      --action=*) action="${1#*=}"; shift ;;
      --lifetime) lifetime="${2:-}"; [[ -n $lifetime ]] || die "--lifetime needs a value"; shift 2 ;;
      --lifetime=*) lifetime="${1#*=}"; shift ;;
      -R | --repeat) lifetime="continuous"; shift ;;
      -n | --dry-run) dry_run=1; shift ;;
      --list) list_modes; exit 0 ;;
      --)
        shift
        extra_opts+=("$@")
        break
        ;;
      *) die "unknown argument: $1; try --help" ;;
    esac
  done

  [[ -n $mode ]] || mode="$(setting defaults.mode)"
  [[ -n $scope ]] || scope="$(setting defaults.scope)"
  [[ -n $action ]] || action="$(setting defaults.action)"
  [[ -n $lifetime ]] || lifetime="$(setting defaults.lifetime)"

  # What each axis may be is the config's to say, not this script's: the same
  # lists are what `imthemousenow-config check` validates the config against.
  expect_one_of "$scope" scope $(setting valid.scope)
  expect_one_of "$action" action $(setting valid.action)
  expect_one_of "$lifetime" lifetime $(setting valid.lifetime)

  # The ACTION the chords asked for. `;` switches away from it and back.
  local base_action="$action"

  if [[ $action == drag ]] && ((dry_run == 0)) && ! has_drag; then
    notify "Drag needs the wl-kbptr this plugin builds; run its install.sh"
    die "--action drag needs the wl-kbptr built by install.sh (pkg/0003-walk-a-path-*.patch)"
  fi

  if ((dry_run == 0)); then
    command -v wl-kbptr >/dev/null 2>&1 || die "wl-kbptr is not installed; run the plugin's install.sh"
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is required"

  # --- mode -----------------------------------------------------------------
  # Resolved per pass, not once, because ALT toggles MODE from inside the
  # overlay the same way the arrows move it between workspaces.
  local chain="" refine="" source="" options="" opencv_cached=""
  resolve_mode() {
    chain="$(setting "mode.$mode.chain")"
    refine="$(setting "mode.$mode.refine")"
    source="$(setting "mode.$mode.source")"
    options=""

    [[ -n $chain ]] || die "unknown mode '$mode'; try --list"

    # hints: OpenCV detection when the build has it, window rectangles when it
    # does not. The fallback is not a lesser mode -- it is exact where detection
    # is heuristic -- so it degrades silently rather than refusing to run.
    if [[ -n $source ]]; then
      if [[ $source == auto ]]; then
        # wl-kbptr --version costs a process; the answer cannot change while
        # we are running, so it is asked once however many passes happen.
        if [[ -z $opencv_cached ]]; then
          if ((dry_run == 0)) && ! has_opencv; then
            opencv_cached="windows"
          else
            opencv_cached="detect"
          fi
        fi
        source="$opencv_cached"
      fi
      case "$source" in
        detect) options="mode_floating.source=detect" ;;
        windows) options="mode_floating.source=stdin" ;;
        *) die "unknown source '$source' for mode '$mode'" ;;
      esac
    fi
  }
  resolve_mode

  # --- command --------------------------------------------------------------
  # Geometry is settled once; ACTION is not, because `;` can switch it while
  # the overlay is up, so the flags are rebuilt for every launch.
  local compiled font=""
  compiled="$("$CONFIG_CMD" compile 2>/dev/null || true)"
  if [[ $(setting theme_font) == true ]]; then
    command -v omarchy-font-current >/dev/null 2>&1 && font="$(omarchy-font-current 2>/dev/null || true)"
  fi

  # Where to draw. Recomputed before every launch, not once: in monitor scope
  # the overlay's own keys move it between workspaces and monitors, and a
  # continuous lifetime outlives windows that move, open or close.
  local mon_name mon_x mon_y mon_w mon_h restrict=""
  compute_geometry() {
    IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h < <(focused_monitor)

    # The drop pass is pinned to the monitor the drag picked up on, whatever
    # the pointer or the focus did in between. A virtual pointer is bound to
    # one output (wl-kbptr's own move_pointer does this too), so a path that
    # leaves that output is not a path it can walk -- and an overlay that let
    # you aim somewhere the drag cannot reach is an overlay that lies.
    #
    # TODO: cross-monitor drags. Interpolating in layout coordinates and
    # re-creating the virtual pointer per output as the path crosses a boundary
    # is the shape of it; whether an application's drag-and-drop session
    # survives that crossing is unverified, which is why this waits.
    #
    # Monitor scope, not the run's: a drop is usually onto something other than
    # the window you picked up from, and window scope would put the overlay
    # over the one place you are least likely to be aiming.
    if session_has drag-anchor; then
      local anchor_mon
      read -r anchor_mon _ _ < <(session_get drag-anchor)
      local pinned
      pinned="$(monitor_by_name "$anchor_mon")"
      # Unplugged mid-drag. The anchor names somewhere that no longer exists,
      # so the drag cannot be finished; fall through to the focused monitor and
      # let the drop pass be aimed there instead of drawing nothing.
      if [[ -n $pinned ]]; then
        IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h <<<"$pinned"
        restrict=""
        return 0
      fi
    fi

    restrict=""
    if [[ $scope == window ]]; then
      local win
      win="$(hyprctl -j activewindow)"
      if [[ $(jq -r '.at // "null"' <<<"$win") != null ]]; then
        local wx wy ww wh
        read -r wx wy ww wh < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$win")
        restrict="${ww}x${wh}+$((wx - mon_x))+$((wy - mon_y))"
      fi
      # No focused window (an empty workspace) falls through to the monitor,
      # which is what you wanted anyway: there is nothing else to aim at.
    fi
  }
  compute_geometry

  # Fills `args` for one launch in ACTION $1.
  args=()
  build_args() {
    local act="$1" modes="$chain" opts="$options"
    [[ -n $refine ]] && modes="$modes,$refine"
    case "$act" in
      # move has no click stage: the pointer lands and stays. Neither half of
      # a drag has one either, and for a sharper reason -- the press is emitted
      # afterwards, once both ends are known, by a separate wl-kbptr --drag.
      # An overlay that clicked here would be a click, not a drag.
      move | drag | drop) ;;
      *) modes="$modes,click"; opts="$opts mode_click.button=${act%-click}" ;;
    esac

    args=()
    [[ -n $compiled && -f $compiled ]] && args+=(-c "$compiled")
    args+=(-o "modes=$modes")

    if [[ -n $font ]]; then
      args+=(-o "mode_tile.label_font_family=$font")
      args+=(-o "mode_floating.label_font_family=$font")
      args+=(-o "mode_bisect.label_font_family=$font")
    fi

    # A different ACTION must look different, or you cannot tell which overlay
    # you are in -- that is the whole reason the relaunch is worth its flicker.
    if [[ $act != "$base_action" ]]; then
      local tint
      tint="$(setting "action.${act}.color")"
      if [[ -n $tint ]]; then
        args+=(-o "mode_tile.label_select_color=${tint}ff")
        args+=(-o "mode_tile.selectable_border_color=${tint}aa")
        args+=(-o "mode_floating.label_select_color=${tint}ff")
        args+=(-o "mode_floating.selectable_border_color=${tint}ee")
        args+=(-o "mode_bisect.pointer_color=${tint}dd")
      fi
    fi

    local opt
    for opt in $opts; do args+=(-o "$opt"); done

    # Per-MODE opacity, which is arithmetic on the theme's own colours rather
    # than colours of its own -- so it is computed where the layers are merged
    # and arrives here as override lines. Before config.local, because a colour
    # written out by hand is a decision and should not be scaled by a number
    # meant for the ones it replaced.
    while IFS= read -r line; do
      [[ -n $line ]] && args+=(-o "$line")
    done < <("$CONFIG_CMD" opacity "$mode" 2>/dev/null || true)

    # User overrides last: one `section.key=value` per line.
    if [[ -f $USER_DIR/config.local ]]; then
      while IFS= read -r line; do
        line="${line%%#*}"
        line="$(echo "$line" | xargs || true)"
        [[ -n $line ]] && args+=(-o "$line")
      done <"$USER_DIR/config.local"
    fi

    args+=(-O "$mon_name")
    [[ -n $restrict ]] && args+=(-r "$restrict")
    ((${#extra_opts[@]})) && args+=("${extra_opts[@]}")
    return 0
  }

  if ((dry_run)); then
    build_args "$action"
    printf '# %s / %s / %s / %s\n' "$mode" "$scope" "$action" "$lifetime"
    printf 'wl-kbptr'
    printf ' %q' "${args[@]}"
    [[ $options == *"source=stdin"* ]] && printf '   # regions on stdin'
    printf '\n'
    exit 0
  fi

  # Only ever one overlay. wl-kbptr grabs the keyboard, so a second instance
  # stacks an unreachable overlay under the new one -- pressing any pointer
  # binding twice used to lock the session out. A non-blocking flock means the
  # second press is a no-op instead. The lock is held by this script, so it is
  # released however the process dies; no stale lock can wedge it.
  if [[ $(setting single_instance) == true ]]; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      exit 0
    fi
  fi

  # Popup-safe mode is decided once, here, and shows up as two things: the
  # submap that carries the relay binds, and the channel wl-kbptr reads them
  # from. Both or neither -- an overlay listening to a channel nobody writes
  # is a keyboard that does nothing, and relay binds with no reader are keys
  # that vanish.
  if [[ $(setting popups.keep_open) == true ]] && has_key_channel; then
    SUBMAP="$SUBMAP_POPUPS"
    mkdir -p "$SESSION_DIR"
    export WL_KBPTR_KEY_CHANNEL="$KEY_CHANNEL"
  fi

  mkdir -p "$STATE_DIR"
  # Everything the overlay's own keys read and write. One call, so a run can
  # never start half-initialised.
  session_begin "$mode" "$scope" "$base_action"

  # Name the ACTION this chord opens in. Once per run, not once per pass: a
  # continuous lifetime relaunches the overlay after every click, and a word
  # flashing back up each time would be noise rather than a signal. Switches
  # made inside the overlay are announced by imthemousenow-steer, where the
  # change actually happens.
  [[ $(setting osd.on_start) == false ]] || osd_action "$base_action" "$scope"

  # `;` must reach us, not wl-kbptr, and must mean nothing at all when no
  # overlay is up. A submap is exactly that: it is entered for the lifetime of
  # the overlay and rebinds one key, leaving every other key to pass through.
  # The trap matters more than the dispatch -- a submap left active would make
  # `;` dead system-wide, so it is reset however this process dies.
  submap_off() {
    hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true
    session_end
  }
  trap submap_off EXIT INT TERM HUP
  hyprctl dispatch "hl.dsp.submap(\"$SUBMAP\")" >/dev/null 2>&1 || true

  # --- run ------------------------------------------------------------------
  # One pass. Regions are recomputed per pass so a continuous lifetime follows
  # windows that move, open or close between clicks.
  run_once() {
    local rc=0
    if [[ $options == *"source=stdin"* ]]; then
      local regions scope_arg
      # imthemousenow-regions speaks the older scope vocabulary.
      [[ $scope == window ]] && scope_arg="active-window" || scope_arg="screen"
      regions="$("$PLUGIN_DIR/bin/imthemousenow-regions" --scope "$scope_arg" || true)"
      if [[ -z $regions ]]; then
        notify "Nothing to label in this $scope"
        return 1
      fi
      wl-kbptr "${args[@]}" <<<"$regions" || rc=$?
    else
      wl-kbptr "${args[@]}" || rc=$?
    fi
    return "$rc"
  }

  local status=0 passes=0 quick_exits=0 started elapsed
  local current_action="$base_action"
  local guard_ms max_quick max_passes
  guard_ms="$(setting continuous.guard_ms)"
  max_quick="$(setting continuous.max_quick_exits)"
  max_passes="$(setting continuous.max_passes)"

  local settle_ms
  settle_ms="$(setting switch.settle_ms)"

  while :; do
    ensure_submap_binds
    # SHIFT and ALT can have rewritten either of these since the last pass.
    scope="$(session_get scope)"
    mode="$(session_get mode)"
    resolve_mode
    compute_geometry
    build_args "$current_action"
    started=$(date +%s%N)
    status=0
    run_once || status=$?

    # A switch is not an exit. wl-kbptr was killed on purpose, so whatever it
    # exited with says nothing; put the overlay back up in the new ACTION
    # without counting a pass.
    local reason=""
    if reason="$(session_take_relaunch)"; then
      current_action="$(session_get action)"
      # A workspace or monitor change is not instant: relaunching before the
      # compositor has settled measures the geometry we just left.
      [[ $reason == geometry ]] && sleep "$(awk "BEGIN{print $settle_ms/1000}")"
      continue
    fi

    # Anything but a completed selection -- Escape (cancellation_status_code),
    # a bad config, a compositor error -- ends the run. Unless the overlay that
    # was cancelled is the swap picker: Tab is a detour, so Escape abandons the
    # detour and puts you back in the overlay you pressed it in. Escape there
    # ends the run, as it always did. Cancelling must not go through
    # swap-commit -- the pointer never moved, so it names a window by accident.
    if ((status != 0)); then
      # Escape during the drop pass abandons the drag. There is nothing to undo
      # -- the press has not happened yet -- so forgetting the anchor is the
      # whole of it, and the axes the drop pass borrowed go back the way a
      # cancelled swap puts its own back.
      if session_has drag-anchor; then
        local rest_mode rest_scope
        read -r rest_mode rest_scope < <(session_get drag-restore)
        [[ -n $rest_mode ]] && session_set mode "$rest_mode"
        [[ -n $rest_scope ]] && session_set scope "$rest_scope"
        session_clear drag-anchor
        session_clear drag-restore
      fi
      if session_has swap-from; then
        "$PLUGIN_DIR/bin/imthemousenow-steer" swap-cancel || true
        current_action="$(session_get action)"
        continue
      fi
      break
    fi

    # A picker pass is not a click: the pointer was moved onto a window in
    # order to name it. Commit the swap, which also puts back the axes the
    # picker borrowed, and put the overlay back on the window it started from
    # -- now somewhere else. Like a switch, it does not count as a pass, so a
    # single lifetime survives its own detour.
    if session_has swap-from; then
      "$PLUGIN_DIR/bin/imthemousenow-steer" swap-commit || true
      current_action="$(session_get action)"
      sleep "$(awk "BEGIN{print $settle_ms/1000}")"
      continue
    fi

    # A drag is two selections and one press, in that order. The first pass
    # only moved the pointer -- onto the thing being picked up -- so remember
    # where that was and put the overlay back up to ask the other half of the
    # question. Like a switch or a swap, it does not count as a pass: one drag
    # is one thing you did, however many overlays it took to say it.
    if [[ $current_action == drag ]]; then
      local anchor_x anchor_y drop_mode
      read -r anchor_x anchor_y < <(pointer_position)
      session_set drag-anchor "$mon_name $anchor_x $anchor_y"
      session_set drag-restore "$(session_get mode) $(session_get scope)"
      drop_mode="$(setting action.drag.drop_mode)"
      [[ -n $drop_mode && $drop_mode != same ]] && session_set mode "$drop_mode"
      current_action="drop"
      session_set action drop
      # The drop overlay looks exactly like the one before it, so the word is
      # the only thing that says which half of the drag you are in. Monitor,
      # because that is where the drop pass is drawn whatever SCOPE says.
      osd_action drop monitor
      continue
    fi

    # Both ends are known, and only now is anything pressed. Everything up to
    # here was the pointer moving, which is why Escape, a switch or a crash at
    # any earlier point cannot leave a button down: there was no button.
    if [[ $current_action == drop ]]; then
      local anchor_mon anchor_x anchor_y drop_x drop_y
      local anchor_mx anchor_my drag_ms rest_mode rest_scope drag_args=()
      read -r anchor_mon anchor_x anchor_y < <(session_get drag-anchor)
      read -r drop_x drop_y < <(pointer_position)
      IFS=$'\t' read -r _ anchor_mx anchor_my _ _ < <(monitor_by_name "$anchor_mon")

      drag_ms="$(setting action.drag.duration_ms)"
      [[ -n $drag_ms ]] || drag_ms=300

      # The same compiled config the overlays got, for one key out of it:
      # mode_click.button. A drag with the middle button is then a config
      # change rather than an option nothing else would ever pass.
      [[ -n $compiled && -f $compiled ]] && drag_args+=(-c "$compiled")
      drag_args+=(-O "$anchor_mon")
      drag_args+=(--drag "$((anchor_x - anchor_mx)),$((anchor_y - anchor_my)),$((drop_x - anchor_mx)),$((drop_y - anchor_my)),$drag_ms")

      wl-kbptr "${drag_args[@]}" || notify "The drag did not complete"

      read -r rest_mode rest_scope < <(session_get drag-restore)
      session_set mode "$rest_mode"
      session_set scope "$rest_scope"
      session_clear drag-anchor
      session_clear drag-restore
      current_action="$base_action"
      session_set action "$base_action"
    fi

    passes=$((passes + 1))

    # One off: a switched-to ACTION lasts exactly one click, then the overlay
    # goes back to what the chord originally asked for.
    if [[ $current_action != "$base_action" ]]; then
      current_action="$base_action"
      session_set action "$base_action"
    fi

    [[ $lifetime == continuous ]] || break

    elapsed=$((($(date +%s%N) - started) / 1000000))
    if ((max_passes > 0 && passes >= max_passes)); then
      break
    fi

    # A pass that "succeeds" instantly means nothing was actually selected;
    # without this a misconfigured run would spin forever.
    if ((elapsed < guard_ms)); then
      quick_exits=$((quick_exits + 1))
      if ((quick_exits >= max_quick)); then
        notify "Continuous stopped: wl-kbptr kept exiting immediately"
        status=1
        break
      fi
    else
      quick_exits=0
    fi
  done

  # Escape is how you leave a continuous lifetime, so it is a success.
  [[ $lifetime == continuous && $status -eq 1 && $passes -gt 0 ]] && status=0

  # Detect builds that start but never find anything (upstream issue #99).
  if [[ $source == detect && $status -ne 0 ]]; then
    echo "detect exited $status" >"$STATE_DIR/last-detect"
  fi

  exit "$status"
}

main "$@"
