#!/bin/bash
# omarchy:summary=Move and click the pointer with the keyboard (wl-kbptr)
# omarchy:args=<preset> [--scope screen|active-window|workspace]
# omarchy:examples=imthemousenow quick | imthemousenow detect --scope active-window

set -euo pipefail

PLUGIN_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}"
USER_DIR="$HOME/.config/omarchy/imthemousenow"
STATE_DIR="$HOME/.local/state/imthemousenow"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow.lock"
CONFIG_CMD="$PLUGIN_DIR/bin/imthemousenow-config"
[[ -x $CONFIG_CMD ]] || CONFIG_CMD="imthemousenow-config"

notify() {
  [[ $("$CONFIG_CMD" get notify 2>/dev/null || echo true) == false ]] && return 0
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u low "I'm the mouse now" "$1"
  else
    command -v notify-send >/dev/null 2>&1 && notify-send "I'm the mouse now" "$1"
  fi
}

die() {
  echo "imthemousenow: $1" >&2
  exit 1
}

# One [imthemousenow] setting, or $2 when it is unset.
setting() {
  local value
  value="$("$CONFIG_CMD" get "$1" 2>/dev/null || true)"
  echo "${value:-$2}"
}

# A preset's fields as key<TAB>value.
read_preset() {
  "$CONFIG_CMD" preset "$1" 2>/dev/null
}

list_presets() {
  "$CONFIG_CMD" presets | while IFS=$'\t' read -r name description; do
    printf "  %-12s %s\n" "$name" "$description"
  done
}

has_opencv() {
  wl-kbptr --version 2>&1 | grep -qi opencv
}

# Focused monitor as: name<TAB>x<TAB>y<TAB>w<TAB>h
focused_monitor() {
  hyprctl -j monitors | jq -r '.[] | select(.focused) | [.name, .x, .y, (.width / .scale | floor), (.height / .scale | floor)] | @tsv'
}

main() {
  local preset="" scope="" dry_run=0 repeat_mode=0 extra_opts=()

  while (($#)); do
    case "$1" in
      -h | --help)
        cat <<EOF
Usage: imthemousenow <preset> [--scope screen|active-window|workspace] [-- <wl-kbptr args>]

Presets:
$(list_presets)

Options:
  --scope <s>   Restrict the overlay to the screen, the active window, or the
                focused workspace's monitor. Overrides the preset's own scope.
  --list        List presets, one name per line.
  -n, --dry-run Print the wl-kbptr command that would run, then exit.
  -R, --repeat  Keep reopening after each click, until Escape cancels. Needs
                general.cancellation_status_code to be non-zero (the Omarchy
                template sets it to 1).
  --stop        Close any running overlay. Bind this if you ever get stuck.
  --            Pass everything after this straight to wl-kbptr.
EOF
        exit 0
        ;;
      --stop)
        # Escape hatch: close any overlay that is up, including one left
        # behind by a crash. Safe to run when nothing is running.
        pkill -x wl-kbptr >/dev/null 2>&1 || true
        exit 0
        ;;
      -R | --repeat)
        repeat_mode=1
        shift
        ;;
      -n | --dry-run)
        dry_run=1
        shift
        ;;
      --list)
        list_presets
        exit 0
        ;;
      --scope)
        scope="${2:-}"
        [[ -n $scope ]] || die "--scope needs a value"
        shift 2
        ;;
      --scope=*)
        scope="${1#*=}"
        shift
        ;;
      --)
        shift
        extra_opts+=("$@")
        break
        ;;
      -*) die "unknown option: $1" ;;
      *)
        [[ -z $preset ]] || die "only one preset at a time (got '$preset' and '$1')"
        preset="$1"
        shift
        ;;
    esac
  done

  [[ -n $preset ]] || preset="$(setting default_preset "")"
  [[ -n $preset ]] || die "no preset given; try --help"
  if ((dry_run == 0)); then
    command -v wl-kbptr >/dev/null 2>&1 || die "wl-kbptr is not installed; run the plugin's install.sh"
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is required"

  # --- preset ---------------------------------------------------------------
  local modes="" options="" needs="" preset_scope=""
  while IFS=$'\t' read -r key value; do
    case "$key" in
      modes) modes="$value" ;;
      options) options="$value" ;;
      needs) needs="$value" ;;
      scope) preset_scope="$value" ;;
    esac
  done < <(read_preset "$preset")

  [[ -n $modes ]] || die "unknown preset '$preset'; try --list"
  [[ -n $scope ]] || scope="${preset_scope:-$(setting scope.default screen)}"

  if [[ $needs == opencv && $dry_run -eq 0 ]] && ! has_opencv; then
    notify "Preset '$preset' needs an OpenCV build of wl-kbptr"
    die "preset '$preset' needs OpenCV support, which this wl-kbptr build lacks"
  fi

  # --- command --------------------------------------------------------------
  local args=() compiled
  compiled="$("$CONFIG_CMD" compile 2>/dev/null || true)"
  [[ -n $compiled && -f $compiled ]] && args+=(-c "$compiled")
  args+=(-o "modes=$modes")

  # Font from the Omarchy theme, applied to every mode that draws labels.
  local font=""
  if [[ $(setting theme_font true) == true ]]; then
    command -v omarchy-font-current >/dev/null 2>&1 && font="$(omarchy-font-current 2>/dev/null || true)"
  fi
  if [[ -n $font ]]; then
    args+=(-o "mode_tile.label_font_family=$font")
    args+=(-o "mode_floating.label_font_family=$font")
    args+=(-o "mode_bisect.label_font_family=$font")
  fi

  local opt
  for opt in $options; do args+=(-o "$opt"); done

  # User overrides last: one `section.key=value` per line.
  if [[ -f $USER_DIR/config.local ]]; then
    while IFS= read -r line; do
      line="${line%%#*}"
      line="$(echo "$line" | xargs || true)"
      [[ -n $line ]] && args+=(-o "$line")
    done <"$USER_DIR/config.local"
  fi

  # --- scope ----------------------------------------------------------------
  local mon_name mon_x mon_y mon_w mon_h
  IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h < <(focused_monitor)
  args+=(-O "$mon_name")

  case "$scope" in
    screen | workspace) ;;
    active-window)
      local win
      win="$(hyprctl -j activewindow)"
      if [[ $(jq -r '.at // "null"' <<<"$win") != null ]]; then
        local wx wy ww wh
        read -r wx wy ww wh < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$win")
        args+=(-r "${ww}x${wh}+$((wx - mon_x))+$((wy - mon_y))")
      fi
      ;;
    *) die "unknown scope '$scope'" ;;
  esac

  ((${#extra_opts[@]})) && args+=("${extra_opts[@]}")

  if ((dry_run)); then
    printf 'wl-kbptr'
    printf ' %q' "${args[@]}"
    [[ $options == *"source=stdin"* ]] && printf '   # regions on stdin'
    printf '\n'
    exit 0
  fi

  # Only ever one overlay. wl-kbptr grabs the keyboard, so a second instance
  # stacks an unreachable overlay under the new one -- pressing any pointer
  # binding twice used to lock the session out. A non-blocking flock means the
  # second press is a no-op instead. The lock is held by this script, so it is
  # released however the process dies; no stale lock can wedge it.
  if [[ $(setting single_instance true) == true ]]; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      exit 0
    fi
  fi

  mkdir -p "$STATE_DIR"

  # --- run ------------------------------------------------------------------
  # One pass. Regions are recomputed per pass so repeat mode follows windows
  # that move, open or close between clicks.
  run_once() {
    local rc=0
    if [[ $options == *"source=stdin"* ]]; then
      local regions
      regions="$("$PLUGIN_DIR/bin/imthemousenow-regions" --scope "$scope" || true)"
      if [[ -z $regions ]]; then
        notify "No regions found for '$preset'"
        return 1
      fi
      wl-kbptr "${args[@]}" <<<"$regions" || rc=$?
    else
      wl-kbptr "${args[@]}" || rc=$?
    fi
    return "$rc"
  }

  local status=0
  if ((repeat_mode)); then
    # Exit 0 means a completed selection: go again. Anything else -- Escape
    # (cancellation_status_code), a bad config, a compositor error -- stops.
    local passes=0 quick_exits=0 started elapsed
    local guard_ms max_quick max_passes
    guard_ms="$(setting repeat.guard_ms 200)"
    max_quick="$(setting repeat.max_quick_exits 5)"
    max_passes="$(setting repeat.max_passes 0)"
    while :; do
      started=$(date +%s%N)
      status=0
      run_once || status=$?
      ((status == 0)) || break

      passes=$((passes + 1))
      elapsed=$(((  $(date +%s%N) - started ) / 1000000 ))

      # A pass that "succeeds" instantly means nothing was actually selected;
      # without this a misconfigured run would spin forever.
      if ((max_passes > 0 && passes >= max_passes)); then
        break
      fi

      if ((elapsed < guard_ms)); then
        quick_exits=$((quick_exits + 1))
        if ((quick_exits >= max_quick)); then
          notify "Repeat mode stopped: wl-kbptr kept exiting immediately"
          status=1
          break
        fi
      else
        quick_exits=0
      fi
    done

    # Escape is how you leave repeat mode, so it is a success, not a failure.
    [[ $status -eq 1 && $passes -gt 0 ]] && status=0
  else
    status=0
    run_once || status=$?
  fi

  # Detect builds that start but never find anything (upstream issue #99).
  if [[ $preset == detect && $status -ne 0 ]]; then
    echo "detect exited $status" >"$STATE_DIR/last-detect"
  fi

  exit "$status"
}

main "$@"
