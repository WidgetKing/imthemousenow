#!/bin/bash
# omarchy:summary=Move and click the pointer with the keyboard
# omarchy:args=[--mode grid|hints] [--scope window|monitor] [--action ...] [--lifetime ...]
# omarchy:examples=imthemousenow | imthemousenow --mode grid --scope monitor
#
# Every invocation is four independent choices:
#
#   MODE      grid | hints          how targets are presented
#   SCOPE     window | monitor      where the overlay is drawn
#   ACTION    left-click | right-click | move | drag | hold | scroll
#   LIFETIME  single | continuous   one selection, or until Escape
#
# Unset choices come from [imthemousenow.defaults].
#
# This launches an overlay and keeps it up. Changing one that is already up is
# imthemousenow-steer's job -- the overlay's own keys run that, not this.

set -euo pipefail

LIB_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}/bin"
[[ -f $LIB_DIR/imthemousenow-lib.sh ]] || LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=imthemousenow-lib.sh
source "$LIB_DIR/imthemousenow-lib.sh"
# shellcheck source=imthemousenow-session.sh
source "$LIB_DIR/imthemousenow-session.sh"

USER_DIR="$HOME/.config/omarchy/imthemousenow"
STATE_DIR="$HOME/.local/state/imthemousenow"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow.lock"
STEER_CMD="$LIB_DIR/imthemousenow-steer"
[[ -x $STEER_CMD ]] || STEER_CMD="imthemousenow-steer"
HELP_CMD="$LIB_DIR/imthemousenow-help"
[[ -x $HELP_CMD ]] || HELP_CMD="imthemousenow-help"
POOL_CMD="$LIB_DIR/imthemousenow-pool"
[[ -x $POOL_CMD ]] || POOL_CMD="imthemousenow-pool"
HOLD_CMD="$LIB_DIR/imthemousenow-hold"
[[ -x $HOLD_CMD ]] || HOLD_CMD="imthemousenow-hold"
SCROLL_CMD="$LIB_DIR/imthemousenow-scroll"
[[ -x $SCROLL_CMD ]] || SCROLL_CMD="imthemousenow-scroll"
SUBMAP="imthemousenow"
# EXPERIMENTAL, chosen by popups.keep_open: the same overlay with its keys
# coming from compositor bindings, so it never takes keyboard focus and the
# popup it is drawn over lives on. See hypr/imthemousenow.lua.
SUBMAP_POPUPS="imthemousenow-popups"
KEY_CHANNEL="$SESSION_DIR/keys"
# Mirrors RELAY_KEYS in hypr/imthemousenow.lua; keep them in step. Only the
# names, not how each one is bound: `space` is relayed on release as well as
# press (the peek needs to know when the hand comes off it), and that pairing
# lives in the lua, in the function this file re-asserts binds through.
# Escape is NOT here, and is bound on its own: with the key sheet up there is
# no overlay for it to cancel, and the sheet takes no keyboard in this mode, so
# it has to reach imthemousenow-steer first and be relayed only if no sheet is
# showing. The lua keeps the same exception, for the same reason.
RELAY_KEYS=(comma BackSpace Return space {a..z})

# The other value on an axis: what a modifier means. SCOPE and LIFETIME have
# exactly two, so "the other" is unambiguous. MODE is the config's list and can
# have more than two -- `windows` ships, and a user can add their own -- so it
# is the first one that is not the one we are on, which for the pair the chords
# are documented around (hints, grid) is still the other of the two. Falls back
# to the value it was given when the axis somehow has only one, because a chord
# that opens the wrong overlay is better than a chord that opens none.
other_value() {
  local axis="$1" current="$2" candidate
  for candidate in $(setting "valid.$axis"); do
    [[ $candidate == "$current" ]] || { echo "$candidate"; return; }
  done
  echo "$current"
}

list_modes() {
  local name
  for name in $(setting valid.mode); do
    printf "              %-8s %s\n" "$name" "$(setting "mode.$name.description")"
  done
}

# The theme's monospace font, as omarchy-font-current says it. That is an
# fc-match, which costs more than everything else a chord does in bash put
# together, and its answer only moves when `omarchy font set` rewrites the
# fontconfig file -- so it is kept, beside the config cache, until that file is
# newer. The first line says whether the file existed, so creating or deleting
# it is a change too.
current_font() {
  local cache="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow/font" fonts="$HOME/.config/fontconfig/fonts.conf"
  local key="# $HOME|$([[ -e $fonts ]] && echo 1 || echo 0)" first font
  if [[ -f $cache && ! $fonts -nt $cache ]] && { IFS= read -r first && IFS= read -r font; } <"$cache" &&
    [[ $first == "$key" ]]; then
    echo "$font"
    return
  fi
  command -v omarchy-font-current >/dev/null 2>&1 || return 0
  font="$(omarchy-font-current 2>/dev/null || true)"
  [[ -n $font ]] && mkdir -p "${cache%/*}" 2>/dev/null &&
    printf '%s\n%s\n' "$key" "$font" >"$cache" 2>/dev/null
  echo "$font"
}

has_opencv() {
  wl-kbptr --version 2>&1 | grep -qi opencv
}

# What each patched feature is called inside the binary. `binary_knows` in
# imthemousenow-lib.sh says why the binary is asked this way and what it costs
# to guess wrong; an ACTION asks the same question through its `requires`
# field, which is the same question with the name coming from the config.
has_key_channel() { binary_knows WL_KBPTR_KEY_CHANNEL; }
has_peek() { binary_knows peek_alpha; }
# Focused monitor as: name<TAB>x<TAB>y<TAB>w<TAB>h
# $1 must be one of the remaining arguments.
expect_one_of() {
  local value="$1" label="$2"
  shift 2
  local candidate
  for candidate in "$@"; do
    [[ $value == "$candidate" ]] && return 0
  done
  die "unknown $label '$value'; expected one of: $*"
}

# Some of our submap binds do not survive an overlay: when wl-kbptr exits,
# Hyprland drops exactly the LEFT/RIGHT/UP/DOWN binds -- reproducibly, with
# wl-kbptr launched by hand and no submap involved, while SEMICOLON and the
# digits in the same submap survive untouched. So they are re-asserted before
# every launch. `hl.define_submap` appends to a submap that already exists, and
# a bind re-asserted while present is DUPLICATED rather than replaced, so only
# the missing ones may be sent.
#
# The panic key and F5 are in here for a different reason: both must be
# present, and the cost of checking is the same jq call the arrows already
# need. A bind that is already there is skipped, so listing one that does
# survive costs nothing.
# key:command:description -- the description keeps a re-asserted bind looking
# the same as the one hypr/imthemousenow.lua registered at startup.
SUBMAP_KEYS=(
  "LEFT:imthemousenow-steer arrow l:Pointer: previous workspace, or move the window left"
  "RIGHT:imthemousenow-steer arrow r:Pointer: next workspace, or move the window right"
  "UP:imthemousenow-steer arrow u:Pointer: previous monitor, or move the window up"
  "DOWN:imthemousenow-steer arrow d:Pointer: next monitor, or move the window down"
  "TAB:imthemousenow-steer swap:Pointer: swap this window with one you pick"
  "apostrophe:imthemousenow-steer action drag:Pointer: pick something up, then say where to drop it"
  "SHIFT + apostrophe:imthemousenow-steer action hold:Pointer: take hold of something and steer it by hand"
  "F5:imthemousenow-steer refresh:Pointer: rebuild the overlay against the screen as it is now"
  "F1:imthemousenow-steer help:Pointer: show the keys this overlay listens to"
  "CTRL + ALT + DELETE:imthemousenow-panic:Pointer: close the overlay and all windows"
)

ensure_submap_binds() {
  local present present_keys body="" entry bind key mask cmd description
  # Two lists out of it, because the two loops below ask different questions. The
  # chords need `modmask:key` pairs: `'` and `"` are one key with two binds on
  # it, and a list of names alone cannot tell them apart -- the chord would
  # look present whenever the bare key was, and a dropped one would never come
  # back. Hyprland's modmask is a bitfield; only the four modifiers these binds
  # use are spelled out below.
  #
  # The relay binds need the names alone, because that is all this file knows
  # about them: how each one is bound lives in the lua (`space` is relayed on
  # release as well as press), so a mask asked for here would be a guess, and a
  # wrong guess re-binds a key that is already bound. Which is not harmless --
  # a doubly-bound label key relays each press twice, so one keypress eats both
  # characters of a two-letter label and the NEXT key falls through to the
  # window underneath.
  {
    IFS= read -r present
    IFS= read -r present_keys
  } < <(hyprctl -j binds | jq -r --arg s "$SUBMAP" \
    '[.[] | select(.submap == $s)] | ([.[] | "\(.modmask):\(.key)"] | join(" ")), ([.[] | .key] | join(" "))' 2>/dev/null || true)
  # The relay binds are the whole keyboard in popup-safe mode, so a dropped
  # one is a label that cannot be typed. They are re-asserted by name through
  # the function hypr/imthemousenow.lua exposes, rather than rebuilt here.
  if [[ $SUBMAP == "$SUBMAP_POPUPS" ]]; then
    local relay
    for relay in "${RELAY_KEYS[@]}"; do
      [[ " $present_keys " == *" $relay "* ]] && continue
      body+="imthemousenow_relay_bind(\"$relay\")"$'\n'
    done
    if [[ " $present_keys " != *" Escape "* ]]; then
      body+="hl.bind(\"Escape\", hl.dsp.exec_cmd(\"imthemousenow-steer escape\"),"
      body+=" { description = \"Pointer: close the key sheet, or cancel the overlay\" })"$'\n'
    fi
  fi

  for entry in "${SUBMAP_KEYS[@]}"; do
    bind="${entry%%:*}"
    entry="${entry#*:}"
    cmd="${entry%%:*}"
    description="${entry#*:}"
    # hyprctl reports the key and the modmask separately; the bind we send
    # carries its modifiers in one string, so it is taken apart the same way.
    key="${bind##* }"
    mask=0
    [[ $bind == *SHIFT* ]] && mask=$((mask + 1))
    [[ $bind == *CTRL* ]] && mask=$((mask + 4))
    [[ $bind == *ALT* ]] && mask=$((mask + 8))
    [[ $bind == *SUPER* ]] && mask=$((mask + 64))
    [[ " $present " == *" $mask:$key "* ]] && continue
    body+="hl.bind(\"$bind\", hl.dsp.exec_cmd(\"$cmd\"),"
    body+=" { description = \"$description\" })"$'\n'
  done
  [[ -n $body ]] || return 0
  hyprctl eval "hl.define_submap(\"$SUBMAP\", function()
$body
end)" >/dev/null 2>&1 || true
}

main() {
  local mode="" scope="" action="" lifetime="" dry_run=0 extra_opts=() flips=()

  while (($#)); do
    case "$1" in
      -h | --help)
        cat <<EOF
Usage: imthemousenow [--mode M] [--scope S] [--action A] [--lifetime L]
                     [--flip AXIS]... [-- <wl-kbptr args>]

Every invocation is four independent choices. Anything you leave out comes
from [imthemousenow.defaults] in the config.

  --mode      grid | hints        how targets are presented
$(list_modes)
  --scope     window | monitor    the focused window, or the whole monitor
  --action    left-click | right-click | move | drag | hold | scroll
  --lifetime  single | continuous one selection, or reopen until Escape

Inside the overlay, at the narrowing-down step, the home row picks a sub-area
and three keys commit it:  g = left click,  ; = right click,  b = middle click.
So a right click is always one keypress away, whatever --action says.

Three keys switch ACTION for the whole overlay, at any point before you commit:

  ;   right click                  press again to go back
  :   move (no click)              press again to go back
  '   drag                         press again to go back
  /   scroll there                 then scroll until Escape

Each has its own tint, turned off your theme's accent 72 degrees at a time, so
which one you are in is visible rather than remembered.

Any of them is a one-off: after it lands, ACTION returns to what the chord
asked for, even in a continuous lifetime.

A drag asks twice: once for the thing to pick up, once for where it goes. The
first pass only moves the pointer -- nothing is pressed until both ends are
known -- so \`;\`, \`:\`, \`'\` and Escape all abandon one halfway and leave nothing
held. The drop pass covers the monitor the drag picked up on, and the pointer
takes action.drag.duration_ms to travel, because a client reads drag-and-drop
out of the motion events under a held button and one jump is not enough of
them.

SUPER + ' scrolls where the pointer already is, with no overlay; \`/\` in the
overlay puts the pointer somewhere first. Either way the arrows, hjkl and WASD
turn the wheel a notch per press, with whatever modifiers you hold -- Ctrl to
zoom, Shift to go sideways -- and Escape stops. Modifiers toggled on in the
overlay before \`/\` stay held for the whole scroll.

  F5     rebuild the overlay against the screen as it is now
  Tab    in --scope window: swap this window with one you pick
  Space  hold to fade the overlay and see what is under it

Tapped on their own, the modifiers on the left of the keyboard are commands:
Shift flips SCOPE, Alt flips MODE and Ctrl flips LIFETIME. The ones on the
right are held for the click: tap Ctrl there and the click is a Ctrl click,
tap it again and it is not. They stack -- the word on screen says what is on,
always as Ctrl + Alt + Shift + Super + the ACTION -- and they last for one
press, then are forgotten. A drag keeps what its pick-up pass had into the drop
pass, where more can be added or taken away, and holds them for the whole
drag; a hold holds them for as long as the button is down. Not for a move,
which presses nothing. keyboard_modifier_side = "left" swaps the two sides.

Double click: press again the key that just selected. Which key that is falls
out of the MODE -- a grid commits on Space or Return, so a second Space is the
double click; a hint commits on the last letter of its label, so the hint bd
is double clicked by typing b, d, d. The overlay goes the moment you commit,
and the spot you clicked flickers with LCD pooling for as long as a second
press lands. Every click leaves that mark, right clicks included.

The first click goes out at once either way, so this costs a single click
nothing. What it does cost is that the overlay still holds the keyboard while
the mark is up, so a key typed in that instant is eaten instead of reaching
what you clicked -- one keystroke, and only if you type that fast. The window
follows the desktop's own double-click time; set double_click.ms = 0 in the
config to turn it off.

Space is the peek. Hold it and the whole overlay fades almost away; let go and
it comes back. Nothing moves and nothing is selected, so the labels are still
where they were once you can read the thing you were aiming at. Not available
in the second half of a grid selection: once it reaches bisect, Space commits
the area the way Return does. Set peek_alpha = 1 in the config to turn it off.

An overlay is measured once, when it opens. Press F5 when the screen has moved
underneath it -- a page scrolled, a window resized, a dialog opened -- and the
labels are re-derived from what is on screen now.

Tab opens a picker with one label per window (that is --mode windows, which you
can also ask for directly). The window the overlay is on is not among them --
swapping a window with itself is nothing happening. Picking one swaps it with
the window the overlay is on, and the overlay comes back on that window in its
new place. The arrows walk the picker to another monitor, so the window you
swap with does not have to be on this screen.

The digits and the arrows move what is under the overlay, and what that is
depends on SCOPE. In --scope monitor the overlay is a whole screen, so they
move the screen:

  1..9          switch to that workspace
  Left / Right  previous / next workspace on this monitor
  Up / Down     move the overlay to the previous / next monitor

In --scope window the overlay is one window, so they move that window --
the same thing SUPER + an arrow and SUPER + SHIFT + a digit do outside it:

  1..9          send the window to that workspace, and follow it there
  arrows        move the window left / right / up / down

Either way the overlay is rebuilt around where things ended up, so you keep
aiming without leaving it.

Options:
  --flip AXIS   Take AXIS from the config and use the other value: mode,
                scope or lifetime. Repeatable. This is how the chords compose
                -- see hypr/imthemousenow.lua.
  --list        List modes, one per line.
  -n, --dry-run Print the wl-kbptr command that would run, then exit.
  -R, --repeat  Alias for --lifetime continuous.
  --stop        Close any running overlay. Bind this if you ever get stuck.
  --            Pass everything after this straight to wl-kbptr.
EOF
        exit 0
        ;;
      --stop)
        # Kept here because it is the one documented way out of a stuck
        # overlay and people have it bound; the work itself is steering.
        exec "$STEER_CMD" stop
        ;;
      --mode) mode="${2:-}"; [[ -n $mode ]] || die "--mode needs a value"; shift 2 ;;
      --mode=*) mode="${1#*=}"; shift ;;
      --scope) scope="${2:-}"; [[ -n $scope ]] || die "--scope needs a value"; shift 2 ;;
      --scope=*) scope="${1#*=}"; shift ;;
      --action) action="${2:-}"; [[ -n $action ]] || die "--action needs a value"; shift 2 ;;
      --action=*) action="${1#*=}"; shift ;;
      --flip) flips+=("${2:-}"); [[ -n ${2:-} ]] || die "--flip needs an axis"; shift 2 ;;
      --flip=*) flips+=("${1#*=}"); shift ;;
      --lifetime) lifetime="${2:-}"; [[ -n $lifetime ]] || die "--lifetime needs a value"; shift 2 ;;
      --lifetime=*) lifetime="${1#*=}"; shift ;;
      -R | --repeat) lifetime="continuous"; shift ;;
      -n | --dry-run) dry_run=1; shift ;;
      --list) list_modes; exit 0 ;;
      --)
        shift
        extra_opts+=("$@")
        break
        ;;
      *) die "unknown argument: $1; try --help" ;;
    esac
  done

  [[ -n $mode ]] || mode="$(setting defaults.mode)"
  [[ -n $scope ]] || scope="$(setting defaults.scope)"
  [[ -n $action ]] || action="$(setting defaults.action)"
  [[ -n $lifetime ]] || lifetime="$(setting defaults.lifetime)"

  # The chords are modifiers, and a modifier flips an axis rather than setting
  # it: SUPER + ; is whatever [imthemousenow.defaults] says, and adding SHIFT
  # asks for the other SCOPE -- whichever of the two that now is. Resolved here
  # rather than baked into the keybinding, so a change made in the bar applies
  # to the next keypress instead of waiting for a `hyprctl reload`.
  local axis
  for axis in ${flips+"${flips[@]}"}; do
    case $axis in
      mode) mode="$(other_value mode "$mode")" ;;
      scope) scope="$(other_value scope "$scope")" ;;
      action) action="$(other_value action "$action")" ;;
      lifetime) lifetime="$(other_value lifetime "$lifetime")" ;;
      *) die "--flip does not know the axis '$axis'" ;;
    esac
  done

  # What each axis may be is the config's to say, not this script's: the same
  # lists are what `imthemousenow-config check` validates the config against.
  expect_one_of "$scope" scope $(setting valid.scope)
  expect_one_of "$action" action $(setting valid.action)
  expect_one_of "$lifetime" lifetime $(setting valid.lifetime)

  # The ACTION the chords asked for. `;` switches away from it and back.
  local base_action="$action"

  # Refused up front, while the answer is still "nothing happened". The
  # alternative is aiming an overlay -- twice, for a drag -- and finding out at
  # the press, which is the worst moment to learn the binary cannot do it.
  if ((dry_run == 0)) && ! action_supported "$action"; then
    notify "${action^} needs the wl-kbptr this plugin builds; run its install.sh"
    die "$(action_requirement "$action")"
  fi

  if ((dry_run == 0)); then
    command -v wl-kbptr >/dev/null 2>&1 || die "wl-kbptr is not installed; run the plugin's install.sh"
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is required"

  # --- mode -----------------------------------------------------------------
  # Resolved per pass, not once, because ALT toggles MODE from inside the
  # overlay the same way the arrows move it between workspaces.
  local chain="" refine="" source="" options="" opencv_cached=""
  resolve_mode() {
    chain="$(setting "mode.$mode.chain")"
    refine="$(setting "mode.$mode.refine")"
    source="$(setting "mode.$mode.source")"
    options=""

    [[ -n $chain ]] || die "unknown mode '$mode'; try --list"

    # hints: OpenCV detection when the build has it, window rectangles when it
    # does not. The fallback is not a lesser mode -- it is exact where detection
    # is heuristic -- so it degrades silently rather than refusing to run.
    if [[ -n $source ]]; then
      if [[ $source == auto ]]; then
        # wl-kbptr --version costs a process; the answer cannot change while
        # we are running, so it is asked once however many passes happen.
        if [[ -z $opencv_cached ]]; then
          if ((dry_run == 0)) && ! has_opencv; then
            opencv_cached="windows"
          else
            opencv_cached="detect"
          fi
        fi
        source="$opencv_cached"
      fi
      case "$source" in
        detect) options="mode_floating.source=detect" ;;
        windows) options="mode_floating.source=stdin" ;;
        *) die "unknown source '$source' for mode '$mode'" ;;
      esac
    fi
  }
  resolve_mode

  # --- command --------------------------------------------------------------
  # Geometry is settled once; ACTION is not, because `;` can switch it while
  # the overlay is up, so the flags are rebuilt for every launch.
  local compiled font=""
  # Written by the same `imthemousenow-config env` the settings came from.
  compiled="$MOUSENOW_COMPILED"
  if [[ $(setting theme_font) == true ]]; then
    font="$(current_font)"
  fi

  # Where to draw. Recomputed before every launch, not once: in monitor scope
  # the overlay's own keys move it between workspaces and monitors, and a
  # continuous lifetime outlives windows that move, open or close.
  local mon_name mon_x mon_y mon_w mon_h restrict=""
  compute_geometry() {
    IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h < <(focused_monitor)

    # The drop pass is drawn over one whole monitor: the one the drag picked up
    # on, until an arrow key says another. It follows `drop-monitor` rather
    # than the focus, so nothing the pointer or a window did in between can
    # move the overlay out from under the half-finished drag -- and when an
    # arrow does move it, the path crosses the boundary with it, because
    # wl-kbptr walks the press in layout coordinates.
    #
    # Monitor scope, not the run's: a drop is usually onto something other than
    # the window you picked up from, and window scope would put the overlay
    # over the one place you are least likely to be aiming.
    if session_has drag-anchor; then
      local drop_mon
      drop_mon="$(session_get drop-monitor)"
      if [[ -z $drop_mon ]]; then
        read -r drop_mon _ _ < <(session_get drag-anchor)
      fi
      local pinned
      pinned="$(monitor_by_name "$drop_mon")"
      # Unplugged mid-drag. The monitor named is somewhere that no longer
      # exists; fall through to the focused monitor and let the drop pass be
      # aimed there instead of drawing nothing.
      if [[ -n $pinned ]]; then
        IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h <<<"$pinned"
        restrict=""
        return 0
      fi
    fi

    restrict=""
    if [[ $scope == window ]]; then
      local win
      win="$(hyprctl -j activewindow)"
      if [[ $(jq -r '.at // "null"' <<<"$win") != null ]]; then
        local wx wy ww wh
        read -r wx wy ww wh < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$win")
        restrict="${ww}x${wh}+$((wx - mon_x))+$((wy - mon_y))"
      fi
      # No focused window (an empty workspace) falls through to the monitor,
      # which is what you wanted anyway: there is nothing else to aim at.
    fi
  }
  compute_geometry

  # config.local: one `section.key=value` per line. Read here, once, rather
  # than in build_args, because xargs -- which trims it, and unquotes it the way
  # a shell would -- is a process per line and build_args runs on every pass.
  local local_overrides=() line
  if [[ -f $USER_DIR/config.local ]]; then
    while IFS= read -r line; do
      line="${line%%#*}"
      line="$(echo "$line" | xargs || true)"
      [[ -n $line ]] && local_overrides+=("$line")
    done <"$USER_DIR/config.local"
  fi

  # Fills `args` for one launch in ACTION $1.
  args=()
  build_args() {
    local act="$1" modes="$chain" opts="$options"
    [[ -n $refine ]] && modes="$modes,$refine"
    # Whether this ACTION clicks at all, and with which button, is the
    # registry's to say: an empty `button` presses nothing, which move, both
    # halves of a drag, and hold each need for reasons written beside them in
    # config.default.toml. There is a click stage all the same, with button
    # `none` (see action_overrides): one mode chain for every ACTION is what
    # lets a switch happen without a relaunch.
    local button
    button="$(setting "action.$act.button")"
    modes="$modes,click"

    args=()
    [[ -n $compiled && -f $compiled ]] && args+=(-c "$compiled")
    args+=(-o "modes=$modes")

    if [[ -n $font ]]; then
      args+=(-o "mode_tile.label_font_family=$font")
      args+=(-o "mode_floating.label_font_family=$font")
      args+=(-o "mode_bisect.label_font_family=$font")
    fi

    # The button, the double-click window and the tint: what makes this
    # overlay this ACTION. Double click is the registry's to say as well -- an
    # action with no button has nothing to press twice, and one that has a
    # button may still not want the window (a double right click is not a
    # thing anything listens for). wl-kbptr draws nothing while the window is
    # open; bin/imthemousenow-pool marks where the click went. The same lines
    # are what steer writes to the overrides file for a switch in place, which
    # is why they come from one function. Resolved here first so the
    # double-click cache lands in this shell, not the substitution's.
    double_click_resolve
    while IFS= read -r line; do
      [[ -n $line ]] && args+=(-o "$line")
    done < <(action_overrides "$act" "$base_action")

    # A build that can be reconfigured while it is up is pointed at a file
    # for it, empty at each launch: these args already say what the current
    # ACTION is, and a leftover from the last switch would say otherwise.
    if has_overrides_file; then
      if ((!dry_run)); then
        mkdir -p "$SESSION_DIR"
        : >"$SESSION_DIR/overrides"
      fi
      args+=(--overrides-file "$SESSION_DIR/overrides")
    fi

    local opt
    for opt in $opts; do args+=(-o "$opt"); done

    # The modifiers the modifier side of the keyboard toggled on, held down
    # around the click. A build that can read the session's file is always
    # pointed at it, whatever the ACTION, whether or not anything is on yet:
    # a toggle made after it opened still reaches the click, and an ACTION
    # switched to in place still finds it. One whose button is `none` presses
    # nothing, so holds nothing -- drag and hold are handed them when they do
    # press. Without the file, --modifiers only goes to an ACTION with a click
    # here, and only when the binary knows the flag, which steer has already
    # refused to toggle without, so a stock build never sees it.
    local mods
    mods="$(session_get modifiers)"
    if has_modifiers_file; then
      args+=(--modifiers-file "$SESSION_DIR/modifiers")
    elif [[ -n $button && $(setting "action.$act.modifiers") == true && -n $mods ]] && has_modifiers; then
      args+=(--modifiers "$(modifiers_arg "$mods")")
    fi

    # The peek, only if this binary knows the option. 1 is "already fully
    # drawn", which is how wl-kbptr itself spells off, so there is nothing to
    # pass in that case either.
    local peek
    peek="$(setting peek_alpha)"
    if [[ -n $peek && $peek != 1 && $peek != 1.0 ]] && has_peek; then
      args+=(-o "general.peek_alpha=$peek")
    fi

    # Per-MODE opacity, which is arithmetic on the theme's own colours rather
    # than colours of its own -- so it is computed where the layers are merged
    # and arrives here as override lines. Before config.local, because a colour
    # written out by hand is a decision and should not be scaled by a number
    # meant for the ones it replaced.
    # Worked out with the rest of the settings, one space-separated list per
    # MODE, rather than by a process of its own on every pass.
    local opacity_var="MOUSENOW_OPACITY_${mode//-/_}"
    opacity_var="${opacity_var^^}"
    for line in ${!opacity_var-}; do
      args+=(-o "$line")
    done

    # User overrides last, read once per run above.
    for line in ${local_overrides+"${local_overrides[@]}"}; do
      args+=(-o "$line")
    done

    args+=(-O "$mon_name")
    [[ -n $restrict ]] && args+=(-r "$restrict")
    ((${#extra_opts[@]})) && args+=("${extra_opts[@]}")
    return 0
  }

  if ((dry_run)); then
    build_args "$action"
    printf '# %s / %s / %s / %s\n' "$mode" "$scope" "$action" "$lifetime"
    printf 'wl-kbptr'
    printf ' %q' "${args[@]}"
    [[ $options == *"source=stdin"* ]] && printf '   # regions on stdin'
    printf '\n'
    exit 0
  fi

  # Only ever one overlay. wl-kbptr grabs the keyboard, so a second instance
  # stacks an unreachable overlay under the new one -- pressing any pointer
  # binding twice used to lock the session out. A non-blocking flock means the
  # second press is a no-op instead. The lock is held by this script, so it is
  # released however the process dies; no stale lock can wedge it.
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    exit 0
  fi

  # Popup-safe mode is decided once, here, and shows up as two things: the
  # submap that carries the relay binds, and the channel wl-kbptr reads them
  # from. Both or neither -- an overlay listening to a channel nobody writes
  # is a keyboard that does nothing, and relay binds with no reader are keys
  # that vanish.
  if [[ $(setting popups.keep_open) == true ]] && has_key_channel; then
    SUBMAP="$SUBMAP_POPUPS"
    mkdir -p "$SESSION_DIR"
    export WL_KBPTR_KEY_CHANNEL="$KEY_CHANNEL"
  fi

  mkdir -p "$STATE_DIR"
  # Everything the overlay's own keys read and write. One call, so a run can
  # never start half-initialised.
  session_begin "$mode" "$scope" "$base_action" "$lifetime"

  # Name the ACTION this chord opens in. Once per run, not once per pass: a
  # continuous lifetime relaunches the overlay after every click, and a word
  # flashing back up each time would be noise rather than a signal. Switches
  # made inside the overlay are announced by imthemousenow-steer, where the
  # change actually happens.
  [[ $(setting osd.on_start) == false ]] || osd_action "$base_action" "$scope"

  # `;` must reach us, not wl-kbptr, and must mean nothing at all when no
  # overlay is up. A submap is exactly that: it is entered for the lifetime of
  # the overlay and rebinds one key, leaving every other key to pass through.
  # The trap matters more than the dispatch -- a submap left active would make
  # `;` dead system-wide, so it is reset however this process dies.
  # Set while a hold is on, and the reason this trap is not only about the
  # submap: the button that hold is holding down belongs to a process that
  # releases it when it ends, so ending it is how a dying run lets go.
  local hold_pid="" pool_pid=""
  submap_off() {
    [[ -n $hold_pid ]] && kill "$hold_pid" 2>/dev/null
    # Not killed now: the last click of the run is the moment this exits, and
    # its mark has the rest of its fade still to play. Killed once that is
    # over, by something that does not keep this process waiting for it.
    if [[ -n $pool_pid ]]; then
      setsid -f bash -c "sleep $(ms_to_s $(($(pool_ms) + 100))); kill $pool_pid" \
        >/dev/null 2>&1 </dev/null || kill "$pool_pid" 2>/dev/null
    fi
    hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true
    session_end
  }
  trap submap_off EXIT INT TERM HUP
  hyprctl dispatch "hl.dsp.submap(\"$SUBMAP\")" >/dev/null 2>&1 || true

  # The click mark. Up before the first overlay rather than at the click,
  # because quickshell takes longer to start than a mark lasts; it draws
  # nothing until wl-kbptr writes to the report. The report is removed first
  # so what the last run left in it is not taken for a click. One for the
  # whole run: a continuous lifetime clicks many times, and each is a line.
  if pool_armed; then
    mkdir -p "$SESSION_DIR"
    export WL_KBPTR_CLICK_REPORT="$SESSION_DIR/click-report"
    rm -f "$WL_KBPTR_CLICK_REPORT"
    setsid "$POOL_CMD" --report "$WL_KBPTR_CLICK_REPORT" >/dev/null 2>&1 &
    pool_pid=$!
  fi

  # --- run ------------------------------------------------------------------
  # One pass. Regions are recomputed per pass so a continuous lifetime follows
  # windows that move, open or close between clicks.
  run_once() {
    local rc=0
    if [[ $options == *"source=stdin"* ]]; then
      local regions scope_arg
      # imthemousenow-regions speaks the older scope vocabulary.
      [[ $scope == window ]] && scope_arg="active-window" || scope_arg="screen"
      # The swap picker offers everything but the window the swap started
      # from: swapping a window with itself is nothing happening, and a label
      # on it is a label that can only waste a press.
      local -a region_args=(--scope "$scope_arg")
      session_has swap-from && region_args+=(--exclude "$(session_get swap-from)")
      regions="$("$PLUGIN_DIR/bin/imthemousenow-regions" "${region_args[@]}" || true)"
      if [[ -z $regions ]]; then
        notify "Nothing to label in this $scope"
        return 1
      fi
      wl-kbptr "${args[@]}" <<<"$regions" || rc=$?
    else
      wl-kbptr "${args[@]}" || rc=$?
    fi
    return "$rc"
  }

  # The key sheet, shown in the gap between two passes of the overlay. It has
  # to be a gap rather than a layer on top: in the ordinary submap the sheet
  # reads its own keyboard, and wl-kbptr holds a grab that nothing else may
  # take while it is up. imthemousenow-steer has already killed the overlay by
  # the time this runs -- that is what `session_relaunch help` does -- so this
  # blocks until the sheet is dismissed and the loop then puts the overlay back
  # exactly as it was.
  show_help() {
    local focus="exclusive"
    # Popup-safe mode's one rule: take no keyboard, ever. The sheet is closed
    # by its own compositor bindings there instead.
    [[ $SUBMAP == "$SUBMAP_POPUPS" ]] && focus="none"
    "$HELP_CMD" --focus "$focus" --lifetime "$lifetime" --output "$mon_name" || true
    # Keys pressed at the sheet still fired their submap bindings, and any of
    # them will have asked for a relaunch we are about to do anyway. Consume it
    # so the overlay is not torn down again the moment it comes back.
    session_take_relaunch >/dev/null || true
  }

  local status=0 passes=0 quick_exits=0 started elapsed
  local current_action="$base_action"
  local guard_ms max_quick max_passes
  guard_ms="$(setting continuous.guard_ms)"
  max_quick="$(setting continuous.max_quick_exits)"
  max_passes="$(setting continuous.max_passes)"

  # In seconds, once, for `sleep`.
  local settle
  settle="$(ms_to_s "$(setting switch.settle_ms)")"

  while :; do
    ensure_submap_binds
    # A command-side SHIFT, ALT or CTRL tap can have rewritten these since the
    # last pass.
    scope="$(session_get scope)"
    mode="$(session_get mode)"
    lifetime="$(session_get lifetime)"
    resolve_mode
    compute_geometry
    build_args "$current_action"
    started=$(date +%s%N)
    status=0
    run_once || status=$?
    # `;` between two clicking ACTIONs switches the overlay in place, without
    # a relaunch, so the only place to learn of it is the session.
    current_action="$(session_get action)"

    # A switch is not an exit. wl-kbptr was killed on purpose, so whatever it
    # exited with says nothing; put the overlay back up in the new ACTION
    # without counting a pass.
    local reason=""
    if reason="$(session_take_relaunch)"; then
      # F1 or `?`. Not a switch and not a pass: the overlay that comes back
      # after it is the same one that went away.
      if [[ $reason == help ]]; then
        show_help
        current_action="$(session_get action)"
        continue
      fi
      current_action="$(session_get action)"
      # A workspace or monitor change is not instant: relaunching before the
      # compositor has settled measures the geometry we just left.
      [[ $reason == geometry ]] && sleep "$settle"
      continue
    fi

    # Anything but a completed selection -- Escape (cancellation_status_code),
    # a bad config, a compositor error -- ends the run. Unless the overlay that
    # was cancelled is the swap picker: Tab is a detour, so Escape abandons the
    # detour and puts you back in the overlay you pressed it in. Escape there
    # ends the run, as it always did. Cancelling must not go through
    # swap-commit -- the pointer never moved, so it names a window by accident.
    if ((status != 0)); then
      # Escape during the drop pass abandons the drag. There is nothing to undo
      # -- the press has not happened yet -- so forgetting the anchor is the
      # whole of it, and the axes the drop pass borrowed go back the way a
      # cancelled swap puts its own back.
      if session_has drag-anchor; then
        local rest_mode rest_scope
        read -r rest_mode rest_scope < <(session_get drag-restore)
        [[ -n $rest_mode ]] && session_set mode "$rest_mode"
        [[ -n $rest_scope ]] && session_set scope "$rest_scope"
        session_clear drag-anchor
        session_clear drag-restore
        session_clear drop-monitor
      fi
      if session_has swap-from; then
        "$PLUGIN_DIR/bin/imthemousenow-steer" swap-cancel || true
        current_action="$(session_get action)"
        continue
      fi
      break
    fi

    # A picker pass is not a click: the pointer was moved onto a window in
    # order to name it. Commit the swap, which also puts back the axes the
    # picker borrowed, and put the overlay back on the window it started from
    # -- now somewhere else. Like a switch, it does not count as a pass, so a
    # single lifetime survives its own detour.
    if session_has swap-from; then
      "$PLUGIN_DIR/bin/imthemousenow-steer" swap-commit || true
      current_action="$(session_get action)"
      sleep "$settle"
      continue
    fi

    # A drag is two selections and one press, in that order. The first pass
    # only moved the pointer -- onto the thing being picked up -- so remember
    # where that was and put the overlay back up to ask the other half of the
    # question. Like a switch or a swap, it does not count as a pass: one drag
    # is one thing you did, however many overlays it took to say it.
    if [[ $current_action == drag ]]; then
      local anchor_x anchor_y drop_mode
      read -r anchor_x anchor_y < <(pointer_position)
      session_set drag-anchor "$mon_name $anchor_x $anchor_y"
      session_set drag-restore "$(session_get mode) $(session_get scope)"
      # Where the drop pass starts out. The arrows move it from here, and
      # compute_geometry reads it rather than the focus.
      session_set drop-monitor "$mon_name"
      drop_mode="$(setting action.drag.drop_mode)"
      [[ -n $drop_mode && $drop_mode != same ]] && session_set mode "$drop_mode"
      current_action="drop"
      session_set action drop
      # The drop overlay looks exactly like the one before it, so the word is
      # the only thing that says which half of the drag you are in. Monitor,
      # because that is where the drop pass is drawn whatever SCOPE says.
      osd_action drop monitor "$(session_get modifiers)"
      continue
    fi

    # Both ends are known, and only now is anything pressed. Everything up to
    # here was the pointer moving, which is why Escape, a switch or a crash at
    # any earlier point cannot leave a button down: there was no button.
    if [[ $current_action == drop ]]; then
      local anchor_x anchor_y drop_x drop_y
      local drag_ms rest_mode rest_scope drag_args=()
      # The monitor the anchor was recorded on is not needed here: both ends
      # are layout coordinates, which already say which screen they are on.
      read -r _ anchor_x anchor_y < <(session_get drag-anchor)
      read -r drop_x drop_y < <(pointer_position)

      drag_ms="$(setting action.drag.duration_ms)"
      [[ -n $drag_ms ]] || drag_ms=300

      # The same compiled config the overlays got, for one key out of it:
      # mode_click.button. A drag with the middle button is then a config
      # change rather than an option nothing else would ever pass.
      [[ -n $compiled && -f $compiled ]] && drag_args+=(-c "$compiled")
      # Both ends as Hyprland reports them -- layout coordinates, the space the
      # monitors are laid out in -- and no -O at all. That is what lets the two
      # ends be on different screens: one virtual pointer, unbound to any
      # output, walks the whole path, so the client holding the drag sees one
      # unbroken stream of motion across the boundary.
      drag_args+=(--drag "$anchor_x,$anchor_y,$drop_x,$drop_y,$drag_ms")
      # Whatever is toggled on by now -- carried over from the pick-up pass
      # and changed in the drop pass as you like -- is held for the whole
      # press, travel and release.
      local drag_mods
      drag_mods="$(session_get modifiers)"
      [[ -n $drag_mods ]] && has_modifiers && drag_args+=(--modifiers "$(modifiers_arg "$drag_mods")")

      wl-kbptr "${drag_args[@]}" || notify "The drag did not complete"

      read -r rest_mode rest_scope < <(session_get drag-restore)
      session_set mode "$rest_mode"
      session_set scope "$rest_scope"
      session_clear drag-anchor
      session_clear drag-restore
      session_clear drop-monitor
      current_action="$base_action"
      session_set action "$base_action"
    fi

    # A hold is one selection and one press that stays down. The overlay named
    # what to take hold of and is now gone -- nothing is drawn while a hold is
    # on, because the point of holding rather than dragging is to watch the
    # thing you are moving. imthemousenow-hold owns everything from here: it
    # presses, enters a submap of its own for the keys that steer the pointer,
    # and returns when the button has gone back up. It is blocking for the same
    # reason the key sheet is: the overlay must not come back while it is on.
    if [[ $current_action == hold ]]; then
      local hold_x hold_y
      read -r hold_x hold_y < <(pointer_position)
      # Which submap to put back afterwards. The run is still inside its own,
      # and popup-safe mode makes that a different one.
      # Backgrounded and waited on rather than run in the foreground, so the
      # trap below has a pid to signal: a run loop that is killed -- the panic
      # key, a session ending -- must take the hold down with it, and a hold
      # left running is a button left down.
      # The modifiers go with it, held down for as long as the button is.
      MOUSENOW_SUBMAP="$SUBMAP" MOUSENOW_MODIFIERS="$(session_get modifiers)" \
        "$HOLD_CMD" begin "$hold_x" "$hold_y" &
      hold_pid=$!
      wait "$hold_pid" || true
      hold_pid=""
      current_action="$base_action"
      session_set action "$base_action"
    fi

    # A scroll is `/`: the overlay put the pointer where the wheel should turn,
    # and imthemousenow-scroll takes it from there, exactly as SUPER + ' does
    # with no overlay. Waited on for the hold's reasons, and it shares the
    # hold's pid so the trap below takes it down too.
    if [[ $current_action == scroll ]]; then
      local scroll_x scroll_y
      read -r scroll_x scroll_y < <(pointer_position)
      MOUSENOW_SUBMAP="$SUBMAP" MOUSENOW_MODIFIERS="$(session_get modifiers)" \
        "$SCROLL_CMD" begin "$scroll_x" "$scroll_y" &
      hold_pid=$!
      wait "$hold_pid" || true
      hold_pid=""
      current_action="$base_action"
      session_set action "$base_action"
    fi

    passes=$((passes + 1))

    # A press used the modifiers up. The next one, in a continuous lifetime,
    # starts plain like the first did; one Ctrl click is what was asked for.
    session_clear modifiers

    # One off: a switched-to ACTION lasts exactly one click, then the overlay
    # goes back to what the chord originally asked for.
    if [[ $current_action != "$base_action" ]]; then
      current_action="$base_action"
      session_set action "$base_action"
    fi

    # A command-side CTRL tap can have flipped it since the run began.
    lifetime="$(session_get lifetime)"
    [[ $lifetime == continuous ]] || break

    elapsed=$((($(date +%s%N) - started) / 1000000))
    if ((max_passes > 0 && passes >= max_passes)); then
      break
    fi

    # A pass that "succeeds" instantly means nothing was actually selected;
    # without this a misconfigured run would spin forever.
    if ((elapsed < guard_ms)); then
      quick_exits=$((quick_exits + 1))
      if ((quick_exits >= max_quick)); then
        notify "Continuous stopped: wl-kbptr kept exiting immediately"
        status=1
        break
      fi
    else
      quick_exits=0
    fi
  done

  lifetime="$(session_get lifetime)"
  # Escape is how you leave a continuous lifetime, so it is a success.
  [[ $lifetime == continuous && $status -eq 1 && $passes -gt 0 ]] && status=0

  # Detect builds that start but never find anything (upstream issue #99).
  if [[ $source == detect && $status -ne 0 ]]; then
    echo "detect exited $status" >"$STATE_DIR/last-detect"
  fi

  exit "$status"
}

main "$@"
