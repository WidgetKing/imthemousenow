#!/bin/bash
# omarchy:summary=Move and click the pointer with the keyboard
# omarchy:args=[--mode grid|hints] [--scope window|monitor] [--action ...] [--lifetime ...]
# omarchy:examples=imthemousenow | imthemousenow --mode grid --scope monitor
#
# Every invocation is four independent choices:
#
#   MODE      grid | hints          how targets are presented
#   SCOPE     window | monitor      where the overlay is drawn
#   ACTION    left-click | right-click | move | drag
#   LIFETIME  single | continuous   one selection, or until Escape
#
# Unset choices come from [imthemousenow.defaults].

set -euo pipefail

PLUGIN_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}"
USER_DIR="$HOME/.config/omarchy/imthemousenow"
STATE_DIR="$HOME/.local/state/imthemousenow"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow.lock"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow"
ACTION_FILE="$RUNTIME_DIR/action"
SWITCH_FILE="$RUNTIME_DIR/switch"
SUBMAP="imthemousenow"
CONFIG_CMD="$PLUGIN_DIR/bin/imthemousenow-config"
[[ -x $CONFIG_CMD ]] || CONFIG_CMD="imthemousenow-config"

notify() {
  [[ $("$CONFIG_CMD" get notify 2>/dev/null || echo true) == false ]] && return 0
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u low "I'm the mouse now" "$1"
  else
    command -v notify-send >/dev/null 2>&1 && notify-send "I'm the mouse now" "$1"
  fi
}

die() {
  echo "imthemousenow: $1" >&2
  exit 1
}

# One [imthemousenow] setting, or $2 when it is unset.
setting() {
  local value
  value="$("$CONFIG_CMD" get "$1" 2>/dev/null || true)"
  echo "${value:-$2}"
}

list_modes() {
  "$CONFIG_CMD" modes | while IFS=$'\t' read -r name description; do
    printf "              %-8s %s\n" "$name" "$description"
  done
}

has_opencv() {
  wl-kbptr --version 2>&1 | grep -qi opencv
}

# Focused monitor as: name<TAB>x<TAB>y<TAB>w<TAB>h
focused_monitor() {
  hyprctl -j monitors | jq -r '.[] | select(.focused) | [.name, .x, .y, (.width / .scale | floor), (.height / .scale | floor)] | @tsv'
}

# $1 must be one of the remaining arguments.
expect_one_of() {
  local value="$1" label="$2"
  shift 2
  local candidate
  for candidate in "$@"; do
    [[ $value == "$candidate" ]] && return 0
  done
  die "unknown $label '$value'; expected one of: $*"
}

main() {
  local mode="" scope="" action="" lifetime="" dry_run=0 extra_opts=()

  while (($#)); do
    case "$1" in
      -h | --help)
        cat <<EOF
Usage: imthemousenow [--mode M] [--scope S] [--action A] [--lifetime L] [-- <wl-kbptr args>]

Every invocation is four independent choices. Anything you leave out comes
from [imthemousenow.defaults] in the config.

  --mode      grid | hints        how targets are presented
$(list_modes)
  --scope     window | monitor    the focused window, or the whole monitor
  --action    left-click | right-click | move | drag
  --lifetime  single | continuous one selection, or reopen until Escape

Inside the overlay, at the narrowing-down step, the home row picks a sub-area
and three keys commit it:  g = left click,  ; = right click,  b = middle click.
So a right click is always one keypress away, whatever --action says.

Options:
  --list        List modes, one per line.
  -n, --dry-run Print the wl-kbptr command that would run, then exit.
  -R, --repeat  Alias for --lifetime continuous.
  --stop        Close any running overlay. Bind this if you ever get stuck.
  --            Pass everything after this straight to wl-kbptr.
EOF
        exit 0
        ;;
      --stop)
        # Escape hatch: close any overlay that is up, including one left
        # behind by a crash. Safe to run when nothing is running.
        pkill -x wl-kbptr >/dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true
        exit 0
        ;;
      --switch-action)
        # Bound to `;` inside the overlay's submap, so it only exists while an
        # overlay is up. wl-kbptr has the keyboard and cannot be reconfigured
        # once running, so switching ACTION means tearing the overlay down and
        # putting it back up: we record the new action, drop a flag the
        # waiting run loop will find, and kill the overlay. The loop relaunches
        # rather than exits, because the flag is there.
        mkdir -p "$RUNTIME_DIR"
        local now next
        now="$(cat "$ACTION_FILE" 2>/dev/null || echo left-click)"
        [[ $now == right-click ]] && next="left-click" || next="right-click"
        echo "$next" >"$ACTION_FILE"
        : >"$SWITCH_FILE"
        pkill -x wl-kbptr >/dev/null 2>&1 || true
        exit 0
        ;;
      --mode) mode="${2:-}"; [[ -n $mode ]] || die "--mode needs a value"; shift 2 ;;
      --mode=*) mode="${1#*=}"; shift ;;
      --scope) scope="${2:-}"; [[ -n $scope ]] || die "--scope needs a value"; shift 2 ;;
      --scope=*) scope="${1#*=}"; shift ;;
      --action) action="${2:-}"; [[ -n $action ]] || die "--action needs a value"; shift 2 ;;
      --action=*) action="${1#*=}"; shift ;;
      --lifetime) lifetime="${2:-}"; [[ -n $lifetime ]] || die "--lifetime needs a value"; shift 2 ;;
      --lifetime=*) lifetime="${1#*=}"; shift ;;
      -R | --repeat) lifetime="continuous"; shift ;;
      -n | --dry-run) dry_run=1; shift ;;
      --list) list_modes; exit 0 ;;
      --)
        shift
        extra_opts+=("$@")
        break
        ;;
      *) die "unknown argument: $1; try --help" ;;
    esac
  done

  [[ -n $mode ]] || mode="$(setting defaults.mode hints)"
  [[ -n $scope ]] || scope="$(setting defaults.scope window)"
  [[ -n $action ]] || action="$(setting defaults.action left-click)"
  [[ -n $lifetime ]] || lifetime="$(setting defaults.lifetime single)"

  expect_one_of "$scope" scope window monitor
  expect_one_of "$action" action left-click right-click move drag
  expect_one_of "$lifetime" lifetime single continuous

  # The ACTION the chords asked for. `;` switches away from it and back.
  local base_action="$action"

  if [[ $action == drag ]]; then
    notify "Drag is not implemented yet"
    die "--action drag is not implemented yet"
  fi

  if ((dry_run == 0)); then
    command -v wl-kbptr >/dev/null 2>&1 || die "wl-kbptr is not installed; run the plugin's install.sh"
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is required"

  # --- mode -----------------------------------------------------------------
  local chain="" refine="" source=""
  while IFS=$'\t' read -r key value; do
    case "$key" in
      chain) chain="$value" ;;
      refine) refine="$value" ;;
      source) source="$value" ;;
    esac
  done < <("$CONFIG_CMD" mode "$mode" 2>/dev/null)

  [[ -n $chain ]] || die "unknown mode '$mode'; try --list"

  local options=""

  # hints: OpenCV detection when the build has it, window rectangles when it
  # does not. The fallback is not a lesser mode -- it is exact where detection
  # is heuristic -- so it degrades silently rather than refusing to run.
  if [[ -n $source ]]; then
    if [[ $source == auto ]]; then
      if ((dry_run == 0)) && ! has_opencv; then
        source="windows"
      else
        source="detect"
      fi
    fi
    case "$source" in
      detect) options="mode_floating.source=detect" ;;
      windows) options="mode_floating.source=stdin" ;;
      *) die "unknown source '$source' for mode '$mode'" ;;
    esac
  fi

  # --- command --------------------------------------------------------------
  # Geometry is settled once; ACTION is not, because `;` can switch it while
  # the overlay is up, so the flags are rebuilt for every launch.
  local compiled font=""
  compiled="$("$CONFIG_CMD" compile 2>/dev/null || true)"
  if [[ $(setting theme_font true) == true ]]; then
    command -v omarchy-font-current >/dev/null 2>&1 && font="$(omarchy-font-current 2>/dev/null || true)"
  fi

  local mon_name mon_x mon_y mon_w mon_h
  IFS=$'\t' read -r mon_name mon_x mon_y mon_w mon_h < <(focused_monitor)

  local restrict=""
  if [[ $scope == window ]]; then
    local win
    win="$(hyprctl -j activewindow)"
    if [[ $(jq -r '.at // "null"' <<<"$win") != null ]]; then
      local wx wy ww wh
      read -r wx wy ww wh < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$win")
      restrict="${ww}x${wh}+$((wx - mon_x))+$((wy - mon_y))"
    fi
    # No focused window (an empty workspace) falls through to the monitor,
    # which is what you wanted anyway: there is nothing else to aim at.
  fi

  # Fills `args` for one launch in ACTION $1.
  args=()
  build_args() {
    local act="$1" modes="$chain" opts="$options"
    [[ -n $refine ]] && modes="$modes,$refine"
    case "$act" in
      # move has no click stage: the pointer lands and stays.
      move) ;;
      *) modes="$modes,click"; opts="$opts mode_click.button=${act%-click}" ;;
    esac

    args=()
    [[ -n $compiled && -f $compiled ]] && args+=(-c "$compiled")
    args+=(-o "modes=$modes")

    if [[ -n $font ]]; then
      args+=(-o "mode_tile.label_font_family=$font")
      args+=(-o "mode_floating.label_font_family=$font")
      args+=(-o "mode_bisect.label_font_family=$font")
    fi

    # A different ACTION must look different, or you cannot tell which overlay
    # you are in -- that is the whole reason the relaunch is worth its flicker.
    if [[ $act != "$base_action" ]]; then
      local tint
      tint="$(setting "action.${act}.color" "")"
      if [[ -n $tint ]]; then
        args+=(-o "mode_tile.label_select_color=${tint}ff")
        args+=(-o "mode_tile.selectable_border_color=${tint}aa")
        args+=(-o "mode_floating.label_select_color=${tint}ff")
        args+=(-o "mode_floating.selectable_border_color=${tint}ee")
        args+=(-o "mode_bisect.pointer_color=${tint}dd")
      fi
    fi

    local opt
    for opt in $opts; do args+=(-o "$opt"); done

    # User overrides last: one `section.key=value` per line.
    if [[ -f $USER_DIR/config.local ]]; then
      while IFS= read -r line; do
        line="${line%%#*}"
        line="$(echo "$line" | xargs || true)"
        [[ -n $line ]] && args+=(-o "$line")
      done <"$USER_DIR/config.local"
    fi

    args+=(-O "$mon_name")
    [[ -n $restrict ]] && args+=(-r "$restrict")
    ((${#extra_opts[@]})) && args+=("${extra_opts[@]}")
    return 0
  }

  if ((dry_run)); then
    build_args "$action"
    printf '# %s / %s / %s / %s\n' "$mode" "$scope" "$action" "$lifetime"
    printf 'wl-kbptr'
    printf ' %q' "${args[@]}"
    [[ $options == *"source=stdin"* ]] && printf '   # regions on stdin'
    printf '\n'
    exit 0
  fi

  # Only ever one overlay. wl-kbptr grabs the keyboard, so a second instance
  # stacks an unreachable overlay under the new one -- pressing any pointer
  # binding twice used to lock the session out. A non-blocking flock means the
  # second press is a no-op instead. The lock is held by this script, so it is
  # released however the process dies; no stale lock can wedge it.
  if [[ $(setting single_instance true) == true ]]; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      exit 0
    fi
  fi

  mkdir -p "$STATE_DIR" "$RUNTIME_DIR"
  rm -f "$SWITCH_FILE"
  echo "$base_action" >"$ACTION_FILE"

  # `;` must reach us, not wl-kbptr, and must mean nothing at all when no
  # overlay is up. A submap is exactly that: it is entered for the lifetime of
  # the overlay and rebinds one key, leaving every other key to pass through.
  # The trap matters more than the dispatch -- a submap left active would make
  # `;` dead system-wide, so it is reset however this process dies.
  submap_off() {
    hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true
  }
  trap submap_off EXIT INT TERM HUP
  hyprctl dispatch "hl.dsp.submap(\"$SUBMAP\")" >/dev/null 2>&1 || true

  # --- run ------------------------------------------------------------------
  # One pass. Regions are recomputed per pass so a continuous lifetime follows
  # windows that move, open or close between clicks.
  run_once() {
    local rc=0
    if [[ $options == *"source=stdin"* ]]; then
      local regions scope_arg
      # imthemousenow-regions speaks the older scope vocabulary.
      [[ $scope == window ]] && scope_arg="active-window" || scope_arg="screen"
      regions="$("$PLUGIN_DIR/bin/imthemousenow-regions" --scope "$scope_arg" || true)"
      if [[ -z $regions ]]; then
        notify "Nothing to label in this $scope"
        return 1
      fi
      wl-kbptr "${args[@]}" <<<"$regions" || rc=$?
    else
      wl-kbptr "${args[@]}" || rc=$?
    fi
    return "$rc"
  }

  local status=0 passes=0 quick_exits=0 started elapsed
  local current_action="$base_action"
  local guard_ms max_quick max_passes
  guard_ms="$(setting continuous.guard_ms 200)"
  max_quick="$(setting continuous.max_quick_exits 5)"
  max_passes="$(setting continuous.max_passes 0)"

  while :; do
    build_args "$current_action"
    started=$(date +%s%N)
    status=0
    run_once || status=$?

    # A switch is not an exit. wl-kbptr was killed on purpose, so whatever it
    # exited with says nothing; put the overlay back up in the new ACTION
    # without counting a pass.
    if [[ -f $SWITCH_FILE ]]; then
      rm -f "$SWITCH_FILE"
      current_action="$(cat "$ACTION_FILE" 2>/dev/null || echo "$base_action")"
      continue
    fi

    # Anything but a completed selection -- Escape (cancellation_status_code),
    # a bad config, a compositor error -- ends the run.
    ((status == 0)) || break

    passes=$((passes + 1))

    # One off: a switched-to ACTION lasts exactly one click, then the overlay
    # goes back to what the chord originally asked for.
    if [[ $current_action != "$base_action" ]]; then
      current_action="$base_action"
      echo "$base_action" >"$ACTION_FILE"
    fi

    [[ $lifetime == continuous ]] || break

    elapsed=$((($(date +%s%N) - started) / 1000000))
    if ((max_passes > 0 && passes >= max_passes)); then
      break
    fi

    # A pass that "succeeds" instantly means nothing was actually selected;
    # without this a misconfigured run would spin forever.
    if ((elapsed < guard_ms)); then
      quick_exits=$((quick_exits + 1))
      if ((quick_exits >= max_quick)); then
        notify "Continuous stopped: wl-kbptr kept exiting immediately"
        status=1
        break
      fi
    else
      quick_exits=0
    fi
  done

  # Escape is how you leave a continuous lifetime, so it is a success.
  [[ $lifetime == continuous && $status -eq 1 && $passes -gt 0 ]] && status=0

  # Detect builds that start but never find anything (upstream issue #99).
  if [[ $source == detect && $status -ne 0 ]]; then
    echo "detect exited $status" >"$STATE_DIR/last-detect"
  fi

  exit "$status"
}

main "$@"
