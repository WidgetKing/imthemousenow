#!/usr/bin/env python3
"""Compile and query imthemousenow's config.

The config is a superset of wl-kbptr's: sections wl-kbptr understands pass
straight through, `[imthemousenow]` and `[mode.*]` are ours and are stripped
before wl-kbptr ever sees the file. Layers, later winning:

  1. config.default.toml         shipped defaults (behaviour, modes)
  2. the Omarchy theme template  rendered colours, if theme_colors is on
  3. ~/.config/omarchy/imthemousenow/config.toml   the user's own

Subcommands:
  compile [--force]   write the wl-kbptr config, print its path
  mode <name>         the MODE's fields, as key<TAB>value
  modes               every MODE name and description
  get <dotted.key>    one [imthemousenow] setting, e.g. continuous.guard_ms
  set <key> <value>   write one setting to the user's config.toml
  toggle <key>        flip one true/false setting
  opacity <mode>      that MODE's opacity as section.key=value override lines
  env                 every setting and mode as MOUSENOW_CFG_* shell assignments
  check               parse every layer and report problems
  path                where each layer lives
"""

from __future__ import annotations

import math
import os
import shlex
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
PLUGIN_DIR = Path(os.environ.get("MOUSENOW_PLUGIN_DIR", HOME / ".local/share/imthemousenow"))
USER_DIR = HOME / ".config/omarchy/imthemousenow"
THEME_CONF = HOME / ".local/state/omarchy/current/theme/wl-kbptr.conf"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "imthemousenow"

DEFAULTS = PLUGIN_DIR / "config.default.toml"
USER_CONF = USER_DIR / "config.toml"
COMPILED = RUNTIME / "wl-kbptr.conf"

# Ours; never emitted to wl-kbptr.
RESERVED = {"imthemousenow", "mode"}


def is_reserved(section: str) -> bool:
    """TOML nests `[imthemousenow.action...]`; the theme template, being ini,
    spells the same thing as one flat section name. Both are ours."""
    return section.split(".", 1)[0] in RESERVED


def die(msg: str, code: int = 1):
    print(f"imthemousenow-config: {msg}", file=sys.stderr)
    sys.exit(code)


def load_toml(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        with path.open("rb") as fh:
            return tomllib.load(fh)
    except tomllib.TOMLDecodeError as exc:
        die(f"{path}: {exc}")


def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def parse_ini(path: Path) -> dict:
    """The theme template renders plain ini, which is a config layer too."""
    out: dict = {}
    if not path.is_file():
        return out
    section = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        # Only a leading # is a comment: every colour value starts with one,
        # so stripping inline "comments" would blank the whole palette.
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            out.setdefault(section, {})
        elif "=" in line and section is not None:
            key, value = line.split("=", 1)
            out[section][key.strip()] = value.strip()
    return out


def nest_reserved(flat: dict) -> dict:
    """Turn ini's `[imthemousenow.action.right-click]` into the nested tables a
    TOML layer would have produced, so both layers merge as one shape."""
    out: dict = {}
    for section, body in flat.items():
        if not is_reserved(section) or "." not in section:
            out[section] = body
            continue
        node = out
        for part in section.split("."):
            node = node.setdefault(part, {})
        node.update(body)
    return out


# --- the ACTION palette ------------------------------------------------------
# Five colours are needed and one is given. `left-click` is the theme's accent,
# straight out of the theme template, because the ordinary overlay should look
# like the rest of the desktop; the other four are turned off it, so a new theme
# repaints the whole set and no hue is ever chosen by hand.
#
# The turning happens in OkLCh, and that choice is the whole reason this is not
# six lines of HSL. Equal hue steps in HSL are not equal steps to an eye: at one
# lightness number, yellows and cyans come out glaring while blues sink into the
# background, so a wheel divided evenly there produces a set where some members
# shout and others are missed. OkLCh is built on a model of human vision, so
# holding L and C still and moving only the hue gives colours of genuinely equal
# weight -- which is exactly what a set of signal colours has to be, none of them
# louder than the rest. Five of them means 360/5 = 72 degrees apart.
#
# Two things stop that from being the whole algorithm, and both were measured
# across all 22 shipped themes rather than guessed:
#
# CHROMA_FLOOR. Four themes have an accent with almost no colour in it at all
# (vantablack and white are grey, solitude and last-horizon nearly so). Rotating
# the hue of a grey produces five greys, and the palette that is meant to tell
# you whether the next keypress right-clicks or drags becomes unreadable. So the
# derived four are given at least this much chroma even when the accent has
# less. They stay muted -- 0.10 is a tint, not a poster -- and left-click keeps
# the accent exactly as the theme wrote it, so a monochrome theme still looks
# monochrome until you switch ACTION, which is the moment you need to be told.
#
# L_MAX. sRGB is not a cylinder: the chroma available at a hue collapses as
# lightness rises, from about 0.32 at mid lightness down to 0.13 for blues. Two
# themes (hackerman, kanagawa) have accents up at L 0.88, where no hue can hold
# enough chroma to separate five of them -- they plateaued at a barely-visible
# 0.066 whatever floor was asked for. Pulling the derived four down to L_MAX
# buys the chroma back. Their weight then differs a little from left-click's,
# which is a fair trade for being able to tell them apart at all.
#
# The result, measured: every shipped theme separates its five by at least 0.096
# in Oklab, where 1.0 is the distance from black to white. tests/action-colors.sh
# asserts it, so a new theme cannot quietly break it.
WHEEL = ("left-click", "right-click", "move", "drag", "drop")
CHROMA_FLOOR = 0.10
L_MIN, L_MAX = 0.45, 0.78
# How far hold sits from drag in lightness, sharing its hue, and how light it
# is allowed to get on the way. L_MAX is a ceiling for the wheel because a
# label has to stay readable against its own background; hold's colour is worn
# by a halo drawn over whatever is on screen, where being pale is a virtue
# rather than a problem, so it may go higher than the five that are labels.
# 0.18 is measured rather than picked: it keeps hold further from drag, in
# every shipped theme, than the closest pair the wheel itself produces.
HOLD_LIGHT_STEP = 0.18
HOLD_L_MAX = 0.90

# Bjorn Ottosson's Oklab, transcribed rather than depended on: this runs on
# every settings() call, and a colour library is not worth a dependency in a
# plugin whose whole install is a build of one C program.
_OKLAB_M1 = (
    (0.4122214708, 0.5363325363, 0.0514459929),
    (0.2119034982, 0.6806995451, 0.1073969566),
    (0.0883024619, 0.2817188376, 0.6299787005),
)
_OKLAB_M2 = (
    (0.2104542553, 0.7936177850, -0.0040720468),
    (1.9779984951, -2.4285922050, 0.4505937099),
    (0.0259040371, 0.7827717662, -0.8086757660),
)


def _srgb_to_linear(u: float) -> float:
    return u / 12.92 if u <= 0.04045 else ((u + 0.055) / 1.055) ** 2.4


def _linear_to_srgb(u: float) -> float:
    return 12.92 * u if u <= 0.0031308 else 1.055 * u ** (1 / 2.4) - 0.055


def parse_hex(value: str):
    """`#rrggbb` (with or without the #, with or without trailing alpha) as
    three 0-255 ints, or None if it is not a colour at all."""
    text = str(value).strip().lstrip("#")
    if len(text) not in (6, 8) or any(c not in "0123456789abcdefABCDEF" for c in text):
        return None
    return tuple(int(text[i : i + 2], 16) for i in (0, 2, 4))


def to_oklch(rgb):
    lin = [_srgb_to_linear(c / 255) for c in rgb]
    lms = [sum(row[i] * lin[i] for i in range(3)) for row in _OKLAB_M1]
    lms = [math.copysign(abs(v) ** (1 / 3), v) for v in lms]
    light, a, b = (sum(row[i] * lms[i] for i in range(3)) for row in _OKLAB_M2)
    return light, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


def _oklch_to_linear(light, chroma, hue):
    a = chroma * math.cos(math.radians(hue))
    b = chroma * math.sin(math.radians(hue))
    l_ = (light + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m_ = (light - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (light - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (
        4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
        -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
        -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_,
    )


def max_chroma(light, hue, ceiling=0.45):
    """The most chroma sRGB can show at this lightness and hue. Bisected rather
    than solved: clamping the channels instead would drag the hue with it, which
    is the one thing the whole approach is for."""
    low, high = 0.0, ceiling
    for _ in range(40):
        mid = (low + high) / 2
        if all(-1e-4 <= c <= 1 + 1e-4 for c in _oklch_to_linear(light, mid, hue)):
            low = mid
        else:
            high = mid
    return low


def oklch_to_hex(light, chroma, hue):
    channels = _oklch_to_linear(light, chroma, hue)
    return "#%02x%02x%02x" % tuple(
        round(min(1.0, max(0.0, _linear_to_srgb(min(1.0, max(0.0, c))))) * 255) for c in channels
    )


def derive_action_colors(merged: dict) -> None:
    """Fill in any ACTION with no colour of its own, in place.

    Only the missing ones: a colour written out by hand -- in the user's
    config.toml, or in their own copy of the theme template -- is a decision,
    and nothing here may second-guess it. Which also means setting left-click's
    by hand repaints all five, since they are all turned off it.
    """
    actions = merged.setdefault("imthemousenow", {}).setdefault("action", {})
    base = parse_hex(actions.get(WHEEL[0], {}).get("color", ""))
    # No accent anywhere: theme_colors is off and nothing was written by hand.
    # Every tint then stays unset, which the callers already read as "no tint".
    if base is None:
        return

    light, chroma, hue = to_oklch(base)
    derived_light = min(max(light, L_MIN), L_MAX)
    hues = [(hue + i * 360 / len(WHEEL)) % 360 for i in range(len(WHEEL))]
    # One chroma for all of them, taken from the most gamut-limited hue in the
    # set. Per-hue maxima would give the set an uneven weight, which is the
    # thing this is trying not to do.
    wanted = max(chroma, CHROMA_FLOOR)
    shared = min(wanted, min(max_chroma(derived_light, h) for h in hues))

    for index, action in enumerate(WHEEL):
        if index == 0:
            continue
        entry = actions.setdefault(action, {})
        if not parse_hex(entry.get("color", "")):
            entry["color"] = oklch_to_hex(derived_light, shared, hues[index])

    # Hold is not on the wheel, and deliberately: a sixth hue puts the whole set
    # closer together than tests/action-colors.sh will accept in every shipped
    # theme, and hold is not a sixth idea anyway -- it is drag with the far end
    # left open. So it takes drag's hue at the other end of the lightness range
    # the wheel is clamped to, which separates the two by more than any pair of
    # neighbouring hues manages while still reading as the same family.
    hold = actions.setdefault("hold", {})
    if not parse_hex(hold.get("color", "")):
        # Brighter than drag where there is room, darker where there is not:
        # the halo is drawn over whatever is on screen rather than over an
        # overlay's own dimming, so a light ring has the better chance of
        # reading against it.
        # Always upwards, and it always has room to go: the wheel's own
        # lightness is clamped at L_MAX, which is below this ceiling by more
        # than the separation the five are held to.
        hold_light = min(derived_light + HOLD_LIGHT_STEP, HOLD_L_MAX)
        drag_hue = hues[WHEEL.index("drag")]
        hold_chroma = min(shared, max_chroma(hold_light, drag_hue))
        hold["color"] = oklch_to_hex(hold_light, hold_chroma, drag_hue)


def settings() -> dict:
    """The merged config, all layers applied."""
    merged = load_toml(DEFAULTS)
    theme_on = merged.get("imthemousenow", {}).get("theme_colors", True)
    user = load_toml(USER_CONF)
    # A user turning theme_colors off must win over the default that turns it on.
    theme_on = user.get("imthemousenow", {}).get("theme_colors", theme_on)
    if theme_on:
        merged = deep_merge(merged, nest_reserved(parse_ini(THEME_CONF)))
    merged = deep_merge(merged, user)
    # Not a setting, and not offered as one. wl-kbptr defaults this to 0, which
    # makes a cancelled selection indistinguishable from a completed one -- the
    # continuous lifetime reads this code to know when to stop, and every caller
    # of wl-kbptr here tells Escape apart from a click by it. Forced after the
    # merge so no layer, theme template included, can put it back to 0.
    merged.setdefault("general", {})["cancellation_status_code"] = 1
    # Last, so the accent it turns is the one every layer agreed on, and so a
    # colour any layer set by hand is already in place to be left alone.
    derive_action_colors(merged)
    return merged


def axis_values(merged: dict) -> dict:
    """What each of the four axes may be. The shell validates its own flags
    against this and `check` validates the config against it, so the vocabulary
    is declared once rather than once per language."""
    actions = merged.get("imthemousenow", {}).get("action", {})
    return {
        "mode": sorted(merged.get("mode", {})),
        "scope": ["window", "monitor"],
        # Every ACTION you can ask for, in the order they are declared. `drop`
        # is declared like the rest and is not among them: it says
        # switchable = false, because you arrive at a drop rather than choosing
        # one, and a flag or a chord naming it would be asking for the second
        # half of something that never had a first.
        "action": [
            name
            for name, entry in actions.items()
            if isinstance(entry, dict) and entry.get("switchable", True)
        ],
        "lifetime": ["single", "continuous"],
    }


# The colours that decide how much of the screen an overlay hides: the dim over
# everything unselectable, and the fill behind each label or area. Labels,
# borders and pointers are deliberately not in here -- an overlay you can see
# through is the point, an overlay you cannot read is not -- so they keep the
# alpha the theme gave them however far this is turned down.
BG_COLOR_KEYS = (
    "unselectable_bg_color",
    "selectable_bg_color",
    "bg_color",
    "area_bg_color",
    "even_area_bg_color",
    "odd_area_bg_color",
)


def parse_color(value: str):
    """`#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa` -> (rgb hex, alpha 0-255).
    wl-kbptr accepts all four and its own defaults use the short forms, so a
    config that has never been through the theme template still scales."""
    text = str(value).strip().lstrip("#")
    if len(text) in (3, 4):
        text = "".join(c * 2 for c in text)
    if len(text) == 6:
        text += "ff"
    if len(text) != 8:
        return None
    try:
        int(text, 16)
    except ValueError:
        return None
    return text[:6], int(text[6:], 16)


def mode_sections(merged: dict, name: str) -> list[str]:
    """The wl-kbptr sections one MODE draws with. A MODE is a chain of wl-kbptr
    modes plus an optional refine step, so its sections are those and nothing
    else -- which is what lets `hints` and `grid` be turned down separately
    even though they are compiled from one file."""
    mode = merged.get("mode", {}).get(name)
    if mode is None:
        die(f"unknown mode '{name}'")
    steps = [s.strip() for s in str(mode.get("chain", "")).split(",")]
    steps += [s.strip() for s in str(mode.get("refine", "")).split(",")]
    return [f"mode_{step}" for step in steps if step]


def opacity_overrides(merged: dict, name: str) -> list[str]:
    """`section.key=#rrggbbaa` lines for one MODE, or nothing when its opacity
    is 1 (or unset). Emitted as -o flags at launch rather than written into the
    compiled config: `hints` and `windows` share [mode_floating], so the same
    section needs different alphas depending on which MODE is running."""
    factors = merged.get("imthemousenow", {}).get("opacity", {})
    factor = factors.get(name, factors.get("default", 1))
    try:
        factor = float(factor)
    except (TypeError, ValueError):
        die(f"[imthemousenow.opacity].{name} = '{factor}' is not a number")
    if factor < 0:
        die(f"[imthemousenow.opacity].{name} = {factor} is negative")
    if factor == 1:
        return []
    lines = []
    for section in mode_sections(merged, name):
        body = merged.get(section, {})
        if not isinstance(body, dict):
            continue
        for key in BG_COLOR_KEYS:
            if key not in body:
                continue
            parsed = parse_color(body[key])
            if parsed is None:
                continue
            rgb, alpha = parsed
            scaled = max(0, min(255, round(alpha * factor)))
            lines.append(f"{section}.{key}=#{rgb}{scaled:02x}")
    return lines


def ini_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def compile_config(force: bool = False) -> Path:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    inputs = [p for p in (DEFAULTS, THEME_CONF, USER_CONF) if p.is_file()]
    if not force and COMPILED.is_file():
        newest = max((p.stat().st_mtime for p in inputs), default=0)
        if COMPILED.stat().st_mtime >= newest:
            return COMPILED

    merged = settings()
    lines = [
        "# Generated by imthemousenow-config. Do not edit.",
        f"# Layers: {', '.join(str(p) for p in inputs)}",
        "",
    ]
    for section, body in merged.items():
        if is_reserved(section) or not isinstance(body, dict):
            continue
        lines.append(f"[{section}]")
        for key, value in body.items():
            if isinstance(value, dict):
                die(f"[{section}].{key} must be a value, not a table")
            lines.append(f"{key}={ini_value(value)}")
        lines.append("")

    COMPILED.write_text("\n".join(lines))
    return COMPILED


def cmd_compile(args):
    print(compile_config(force="--force" in args))


def cmd_mode(args):
    if not args:
        die("mode needs a name")
    mode = settings().get("mode", {}).get(args[0])
    if mode is None:
        die(f"unknown mode '{args[0]}'")
    for key, value in mode.items():
        print(f"{key}\t{ini_value(value)}")


def cmd_modes(args):
    for name, mode in settings().get("mode", {}).items():
        print(f"{name}\t{mode.get('description', '')}")


def cmd_get(args):
    if not args:
        die("get needs a key")
    node = settings().get("imthemousenow", {})
    for part in args[0].split("."):
        if not isinstance(node, dict) or part not in node:
            return  # absent: print nothing, let the caller default
        node = node[part]
    if isinstance(node, dict):
        die(f"'{args[0]}' is a table, not a value")
    print(ini_value(node))


def cmd_opacity(args):
    if not args:
        die("opacity needs a mode name")
    for line in opacity_overrides(settings(), args[0]):
        print(line)


def cmd_check(args):
    problems = []
    if not DEFAULTS.is_file():
        problems.append(f"missing shipped defaults: {DEFAULTS}")
    merged = settings()
    for name, mode in merged.get("mode", {}).items():
        if not isinstance(mode, dict):
            problems.append(f"[mode.{name}] must be a table")
        elif "chain" not in mode:
            problems.append(f"[mode.{name}] has no `chain`")

    # 11 exactly, or wl-kbptr rejects the entire config and every chord looks
    # like a dead keybinding. Cheap to check here; expensive to discover live.
    # A bad opacity is a number that is not one, or a MODE that does not exist:
    # both silently do nothing at launch, where the -o flags are built.
    for name, factor in merged.get("imthemousenow", {}).get("opacity", {}).items():
        if not isinstance(factor, (int, float)) or isinstance(factor, bool):
            problems.append(f"[imthemousenow.opacity].{name} = '{factor}' is not a number")
        elif factor < 0:
            problems.append(f"[imthemousenow.opacity].{name} = {factor} is negative")
        elif name != "default" and name not in merged.get("mode", {}):
            problems.append(f"[imthemousenow.opacity].{name} is not a MODE; try one of {sorted(merged.get('mode', {}))}")

    # The OSD's own settings fail late and quietly otherwise: a bad position or
    # a fade longer than the whole life is a word that never appears, which
    # looks exactly like the feature being off.
    osd = merged.get("imthemousenow", {}).get("osd", {})
    if osd.get("position") not in (None, "top", "center", "bottom"):
        problems.append(f"[imthemousenow.osd].position = '{osd['position']}' is not top, center or bottom")
    for field in ("ms", "fade_ms", "size"):
        value = osd.get(field)
        if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value < 0):
            problems.append(f"[imthemousenow.osd].{field} = '{value}' is not a positive whole number")
    if isinstance(osd.get("ms"), int) and isinstance(osd.get("fade_ms"), int) and osd["fade_ms"] > osd["ms"]:
        problems.append(f"[imthemousenow.osd].fade_ms ({osd['fade_ms']}) is longer than ms ({osd['ms']})")

    # Drag's own settings, which fail at the far end of a two-pass action: a
    # drop_mode that is not a MODE silently leaves the drop pass in whatever
    # MODE it was already in, and a duration that is not a number reaches
    # wl-kbptr as an unparsable --drag and kills the drag after both overlays
    # have been aimed. Both look like drag being broken rather than misspelt.
    drag = merged.get("imthemousenow", {}).get("action", {}).get("drag", {})
    drop_mode = drag.get("drop_mode")
    if drop_mode is not None and drop_mode != "same" and drop_mode not in merged.get("mode", {}):
        problems.append(
            f"[imthemousenow.action.drag].drop_mode = '{drop_mode}' is not `same` or a MODE; "
            f"try one of {sorted(merged.get('mode', {}))}"
        )
    duration = drag.get("duration_ms")
    if duration is not None and (not isinstance(duration, int) or isinstance(duration, bool) or duration < 0):
        problems.append(
            f"[imthemousenow.action.drag].duration_ms = '{duration}' is not a positive whole number"
        )

    keys = merged.get("general", {}).get("home_row_keys", "")
    if keys and len(keys) != 11:
        problems.append(f"general.home_row_keys is {len(keys)} characters; wl-kbptr requires exactly 11")
    if keys and len(set(keys)) != len(keys):
        problems.append("general.home_row_keys has duplicate characters")

    defaults = merged.get("imthemousenow", {}).get("defaults", {})
    for field, valid in axis_values(merged).items():
        value = defaults.get(field)
        if value is not None and value not in valid:
            problems.append(f"[imthemousenow.defaults].{field} = '{value}' is not one of {sorted(valid)}")
    for section, body in merged.items():
        if is_reserved(section):
            continue
        if not isinstance(body, dict):
            problems.append(f"top-level key '{section}' is not in any section")
    for problem in problems:
        print(f"imthemousenow-config: {problem}", file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"ok: {len(merged.get('mode', {}))} modes, compiles to {compile_config(force=True)}")


# One `MOUSENOW_CFG_*=value` line per setting, for a shell to eval once instead
# of launching this program per lookup. A dotted key becomes the variable name:
# `continuous.guard_ms` -> MOUSENOW_CFG_CONTINUOUS_GUARD_MS. Modes come too, as
# MOUSENOW_CFG_MODE_<NAME>_<FIELD>, because the run loop re-reads them on every
# pass and that was the most expensive lookup of the lot.
def env_name(path: str) -> str:
    return "MOUSENOW_CFG_" + path.replace(".", "_").replace("-", "_").upper()


def flatten(node: dict, prefix: str = "") -> dict:
    out = {}
    for key, value in node.items():
        path = f"{prefix}{key}"
        if isinstance(value, dict):
            out.update(flatten(value, f"{path}."))
        else:
            out[path] = ini_value(value)
    return out


def cmd_env(args):
    merged = settings()
    if not DEFAULTS.is_file():
        die(f"missing shipped defaults: {DEFAULTS}")

    flat = flatten(merged.get("imthemousenow", {}))
    for name, mode in merged.get("mode", {}).items():
        flat.update(flatten(mode, f"mode.{name}."))

    for field, valid in axis_values(merged).items():
        flat[f"valid.{field}"] = " ".join(valid)

    for path, value in sorted(flat.items()):
        print(f"{env_name(path)}={shlex.quote(value)}")


# --- writing a setting -------------------------------------------------------
# The menu needs to change a setting without opening an editor, which means
# writing to the user's config.toml rather than compiling out of it. Two rules
# shape all of this:
#
#   1. The file is hand-written and full of the user's own comments. Nothing
#      here reformats it: an existing key has its value replaced in place, a
#      new key is appended to its section, and a new section is appended to the
#      file. tomllib cannot write, and a round-trip through any writer that
#      could would throw the comments away.
#   2. A GUI cannot be trusted to have typed a valid value, and an invalid one
#      fails late and silently -- a dead chord, a word that never appears. So
#      every write is validated first, against the same vocabulary `check`
#      uses, and the file is restored if it somehow lands unparsable anyway.


def shipped() -> dict:
    """The defaults layer alone. Type and existence come from here rather than
    the merge, so a typo cannot be validated against a value the user's own
    previous typo put there."""
    return load_toml(DEFAULTS).get("imthemousenow", {})


def settable_type(path: str):
    """The Python type a dotted key's value must have, or None if no such key
    is settable. A leaf the defaults do not name is allowed when its table is
    named and has a sibling to take the type from -- that is what makes
    `opacity.<mode>` and a new ACTION's `label` reachable without listing every
    MODE here."""
    parts = path.split(".")
    node = shipped()
    for part in parts[:-1]:
        if not isinstance(node, dict) or part not in node:
            return None
        node = node[part]
    if not isinstance(node, dict):
        return None
    leaf = parts[-1]
    if leaf in node and not isinstance(node[leaf], dict):
        return type(node[leaf])
    siblings = [type(v) for v in node.values() if not isinstance(v, dict)]
    if leaf not in node and len(set(siblings)) == 1:
        return siblings[0]
    return None


def settable_enum(path: str, merged: dict):
    """The closed set of values a key accepts, or None if it is not an enum.
    Drawn from axis_values so the four axes are declared once, not twice."""
    axes = axis_values(merged)
    if path.startswith("defaults."):
        return axes.get(path.split(".", 1)[1])
    if path == "osd.position":
        return ["top", "center", "bottom"]
    if path == "action.drag.drop_mode":
        return ["same"] + axes["mode"]
    return None


def parse_as(text: str, want, path: str):
    """The menu hands everything over as a string; TOML needs it typed."""
    if want is bool:
        if text not in ("true", "false"):
            die(f"{path} is a true/false setting; '{text}' is neither")
        return text == "true"
    if want is int:
        try:
            return int(text)
        except ValueError:
            die(f"{path} is a whole number; '{text}' is not")
    if want is float:
        try:
            return float(text)
        except ValueError:
            die(f"{path} is a number; '{text}' is not")
    return text


def toml_literal(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')


def write_setting(path: str, value) -> None:
    """Replace, append to a section, or append a section -- in that order, and
    touching no other line of the file."""
    parts = path.split(".")
    section = ".".join(["imthemousenow"] + parts[:-1])
    key, literal = parts[-1], toml_literal(value)

    USER_DIR.mkdir(parents=True, exist_ok=True)
    original = USER_CONF.read_text() if USER_CONF.is_file() else ""
    lines = original.splitlines()

    start = None
    for index, line in enumerate(lines):
        if line.strip() == f"[{section}]":
            start = index
            break

    if start is None:
        block = ["", f"[{section}]", f"{key} = {literal}"]
        lines = lines + block if lines else block[1:]
    else:
        end = len(lines)
        for index in range(start + 1, len(lines)):
            if lines[index].lstrip().startswith("["):
                end = index
                break
        for index in range(start + 1, end):
            stripped = lines[index].lstrip()
            if stripped.startswith("#") or "=" not in stripped:
                continue
            if stripped.split("=", 1)[0].strip().strip('"') == key:
                lines[index] = f"{key} = {literal}"
                break
        else:
            # Before any trailing blank lines, so the section stays one block.
            tail = end
            while tail > start + 1 and not lines[tail - 1].strip():
                tail -= 1
            lines.insert(tail, f"{key} = {literal}")

    USER_CONF.write_text("\n".join(lines) + "\n")
    try:
        load_toml_strict(USER_CONF)
    except tomllib.TOMLDecodeError as exc:
        USER_CONF.write_text(original)
        die(f"writing {path} would have broken {USER_CONF} ({exc}); nothing was changed")


def load_toml_strict(path: Path) -> dict:
    """load_toml dies on a parse error; this raises, so a bad write can be
    rolled back before anything is reported."""
    with path.open("rb") as fh:
        return tomllib.load(fh)


def cmd_set(args):
    if len(args) < 2:
        die("set needs a key and a value, e.g. `set defaults.action move`")
    path, text = args[0], " ".join(args[1:])

    want = settable_type(path)
    if want is None:
        die(f"'{path}' is not a settable [imthemousenow] key")
    merged = settings()
    valid = settable_enum(path, merged)
    if valid is not None and text not in valid:
        die(f"{path} = '{text}' is not one of {sorted(valid)}")
    value = parse_as(text, want, path)
    if path.startswith("opacity.") and value < 0:
        die(f"{path} = {value} is negative")

    write_setting(path, value)
    print(f"{path} = {ini_value(value)}")


def cmd_toggle(args):
    """One command per boolean row in the menu, so the jsonc does not have to
    read the current value and compute its opposite in shell."""
    if not args:
        die("toggle needs a key")
    path = args[0]
    if settable_type(path) is not bool:
        die(f"'{path}' is not a true/false setting")
    node = settings().get("imthemousenow", {})
    for part in path.split("."):
        node = node.get(part, {}) if isinstance(node, dict) else {}
    cmd_set([path, "false" if node is True else "true"])


def cmd_path(args):
    for label, path in (
        ("defaults", DEFAULTS),
        ("theme", THEME_CONF),
        ("user", USER_CONF),
        ("compiled", COMPILED),
    ):
        mark = "" if path.is_file() else "   (absent)"
        print(f"{label:9} {path}{mark}")


COMMANDS = {
    "compile": cmd_compile,
    "mode": cmd_mode,
    "modes": cmd_modes,
    "get": cmd_get,
    "set": cmd_set,
    "toggle": cmd_toggle,
    "opacity": cmd_opacity,
    "env": cmd_env,
    "check": cmd_check,
    "path": cmd_path,
}

if __name__ == "__main__":
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    handler = COMMANDS.get(argv[0])
    if handler is None:
        die(f"unknown subcommand '{argv[0]}'; try --help")
    handler(argv[1:])
