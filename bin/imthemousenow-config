#!/usr/bin/env python3
"""Compile and query imthemousenow's config.

The config is a superset of wl-kbptr's: sections wl-kbptr understands pass
straight through, `[imthemousenow]` and `[mode.*]` are ours and are stripped
before wl-kbptr ever sees the file. Layers, later winning:

  1. config.default.toml         shipped defaults (behaviour, modes)
  2. the Omarchy theme template  rendered colours, if theme_colors is on
  3. ~/.config/omarchy/imthemousenow/config.toml   the user's own

Subcommands:
  compile [--force]   write the wl-kbptr config, print its path
  mode <name>         the MODE's fields, as key<TAB>value
  modes               every MODE name and description
  get <dotted.key>    one [imthemousenow] setting, e.g. continuous.guard_ms
  opacity <mode>      that MODE's opacity as section.key=value override lines
  env                 every setting and mode as MOUSENOW_CFG_* shell assignments
  check               parse every layer and report problems
  path                where each layer lives
"""

from __future__ import annotations

import os
import shlex
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
PLUGIN_DIR = Path(os.environ.get("MOUSENOW_PLUGIN_DIR", HOME / ".local/share/imthemousenow"))
USER_DIR = HOME / ".config/omarchy/imthemousenow"
THEME_CONF = HOME / ".local/state/omarchy/current/theme/wl-kbptr.conf"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "imthemousenow"

DEFAULTS = PLUGIN_DIR / "config.default.toml"
USER_CONF = USER_DIR / "config.toml"
COMPILED = RUNTIME / "wl-kbptr.conf"

# Ours; never emitted to wl-kbptr.
RESERVED = {"imthemousenow", "mode"}


def is_reserved(section: str) -> bool:
    """TOML nests `[imthemousenow.action...]`; the theme template, being ini,
    spells the same thing as one flat section name. Both are ours."""
    return section.split(".", 1)[0] in RESERVED


def die(msg: str, code: int = 1):
    print(f"imthemousenow-config: {msg}", file=sys.stderr)
    sys.exit(code)


def load_toml(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        with path.open("rb") as fh:
            return tomllib.load(fh)
    except tomllib.TOMLDecodeError as exc:
        die(f"{path}: {exc}")


def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def parse_ini(path: Path) -> dict:
    """The theme template renders plain ini, which is a config layer too."""
    out: dict = {}
    if not path.is_file():
        return out
    section = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        # Only a leading # is a comment: every colour value starts with one,
        # so stripping inline "comments" would blank the whole palette.
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            out.setdefault(section, {})
        elif "=" in line and section is not None:
            key, value = line.split("=", 1)
            out[section][key.strip()] = value.strip()
    return out


def nest_reserved(flat: dict) -> dict:
    """Turn ini's `[imthemousenow.action.right-click]` into the nested tables a
    TOML layer would have produced, so both layers merge as one shape."""
    out: dict = {}
    for section, body in flat.items():
        if not is_reserved(section) or "." not in section:
            out[section] = body
            continue
        node = out
        for part in section.split("."):
            node = node.setdefault(part, {})
        node.update(body)
    return out


def settings() -> dict:
    """The merged config, all layers applied."""
    merged = load_toml(DEFAULTS)
    theme_on = merged.get("imthemousenow", {}).get("theme_colors", True)
    user = load_toml(USER_CONF)
    # A user turning theme_colors off must win over the default that turns it on.
    theme_on = user.get("imthemousenow", {}).get("theme_colors", theme_on)
    if theme_on:
        merged = deep_merge(merged, nest_reserved(parse_ini(THEME_CONF)))
    return deep_merge(merged, user)


def axis_values(merged: dict) -> dict:
    """What each of the four axes may be. The shell validates its own flags
    against this and `check` validates the config against it, so the vocabulary
    is declared once rather than once per language."""
    return {
        "mode": sorted(merged.get("mode", {})),
        "scope": ["window", "monitor"],
        "action": ["left-click", "right-click", "move", "drag"],
        "lifetime": ["single", "continuous"],
    }


# The colours that decide how much of the screen an overlay hides: the dim over
# everything unselectable, and the fill behind each label or area. Labels,
# borders and pointers are deliberately not in here -- an overlay you can see
# through is the point, an overlay you cannot read is not -- so they keep the
# alpha the theme gave them however far this is turned down.
BG_COLOR_KEYS = (
    "unselectable_bg_color",
    "selectable_bg_color",
    "bg_color",
    "area_bg_color",
    "even_area_bg_color",
    "odd_area_bg_color",
)


def parse_color(value: str):
    """`#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa` -> (rgb hex, alpha 0-255).
    wl-kbptr accepts all four and its own defaults use the short forms, so a
    config that has never been through the theme template still scales."""
    text = str(value).strip().lstrip("#")
    if len(text) in (3, 4):
        text = "".join(c * 2 for c in text)
    if len(text) == 6:
        text += "ff"
    if len(text) != 8:
        return None
    try:
        int(text, 16)
    except ValueError:
        return None
    return text[:6], int(text[6:], 16)


def mode_sections(merged: dict, name: str) -> list[str]:
    """The wl-kbptr sections one MODE draws with. A MODE is a chain of wl-kbptr
    modes plus an optional refine step, so its sections are those and nothing
    else -- which is what lets `hints` and `grid` be turned down separately
    even though they are compiled from one file."""
    mode = merged.get("mode", {}).get(name)
    if mode is None:
        die(f"unknown mode '{name}'")
    steps = [s.strip() for s in str(mode.get("chain", "")).split(",")]
    steps += [s.strip() for s in str(mode.get("refine", "")).split(",")]
    return [f"mode_{step}" for step in steps if step]


def opacity_overrides(merged: dict, name: str) -> list[str]:
    """`section.key=#rrggbbaa` lines for one MODE, or nothing when its opacity
    is 1 (or unset). Emitted as -o flags at launch rather than written into the
    compiled config: `hints` and `windows` share [mode_floating], so the same
    section needs different alphas depending on which MODE is running."""
    factors = merged.get("imthemousenow", {}).get("opacity", {})
    factor = factors.get(name, factors.get("default", 1))
    try:
        factor = float(factor)
    except (TypeError, ValueError):
        die(f"[imthemousenow.opacity].{name} = '{factor}' is not a number")
    if factor < 0:
        die(f"[imthemousenow.opacity].{name} = {factor} is negative")
    if factor == 1:
        return []
    lines = []
    for section in mode_sections(merged, name):
        body = merged.get(section, {})
        if not isinstance(body, dict):
            continue
        for key in BG_COLOR_KEYS:
            if key not in body:
                continue
            parsed = parse_color(body[key])
            if parsed is None:
                continue
            rgb, alpha = parsed
            scaled = max(0, min(255, round(alpha * factor)))
            lines.append(f"{section}.{key}=#{rgb}{scaled:02x}")
    return lines


def ini_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def compile_config(force: bool = False) -> Path:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    inputs = [p for p in (DEFAULTS, THEME_CONF, USER_CONF) if p.is_file()]
    if not force and COMPILED.is_file():
        newest = max((p.stat().st_mtime for p in inputs), default=0)
        if COMPILED.stat().st_mtime >= newest:
            return COMPILED

    merged = settings()
    lines = [
        "# Generated by imthemousenow-config. Do not edit.",
        f"# Layers: {', '.join(str(p) for p in inputs)}",
        "",
    ]
    for section, body in merged.items():
        if is_reserved(section) or not isinstance(body, dict):
            continue
        lines.append(f"[{section}]")
        for key, value in body.items():
            if isinstance(value, dict):
                die(f"[{section}].{key} must be a value, not a table")
            lines.append(f"{key}={ini_value(value)}")
        lines.append("")

    COMPILED.write_text("\n".join(lines))
    return COMPILED


def cmd_compile(args):
    print(compile_config(force="--force" in args))


def cmd_mode(args):
    if not args:
        die("mode needs a name")
    mode = settings().get("mode", {}).get(args[0])
    if mode is None:
        die(f"unknown mode '{args[0]}'")
    for key, value in mode.items():
        print(f"{key}\t{ini_value(value)}")


def cmd_modes(args):
    for name, mode in settings().get("mode", {}).items():
        print(f"{name}\t{mode.get('description', '')}")


def cmd_get(args):
    if not args:
        die("get needs a key")
    node = settings().get("imthemousenow", {})
    for part in args[0].split("."):
        if not isinstance(node, dict) or part not in node:
            return  # absent: print nothing, let the caller default
        node = node[part]
    if isinstance(node, dict):
        die(f"'{args[0]}' is a table, not a value")
    print(ini_value(node))


def cmd_opacity(args):
    if not args:
        die("opacity needs a mode name")
    for line in opacity_overrides(settings(), args[0]):
        print(line)


def cmd_check(args):
    problems = []
    if not DEFAULTS.is_file():
        problems.append(f"missing shipped defaults: {DEFAULTS}")
    merged = settings()
    for name, mode in merged.get("mode", {}).items():
        if not isinstance(mode, dict):
            problems.append(f"[mode.{name}] must be a table")
        elif "chain" not in mode:
            problems.append(f"[mode.{name}] has no `chain`")

    # 11 exactly, or wl-kbptr rejects the entire config and every chord looks
    # like a dead keybinding. Cheap to check here; expensive to discover live.
    # A bad opacity is a number that is not one, or a MODE that does not exist:
    # both silently do nothing at launch, where the -o flags are built.
    for name, factor in merged.get("imthemousenow", {}).get("opacity", {}).items():
        if not isinstance(factor, (int, float)) or isinstance(factor, bool):
            problems.append(f"[imthemousenow.opacity].{name} = '{factor}' is not a number")
        elif factor < 0:
            problems.append(f"[imthemousenow.opacity].{name} = {factor} is negative")
        elif name != "default" and name not in merged.get("mode", {}):
            problems.append(f"[imthemousenow.opacity].{name} is not a MODE; try one of {sorted(merged.get('mode', {}))}")

    # The OSD's own settings fail late and quietly otherwise: a bad position or
    # a fade longer than the whole life is a word that never appears, which
    # looks exactly like the feature being off.
    osd = merged.get("imthemousenow", {}).get("osd", {})
    if osd.get("position") not in (None, "top", "center", "bottom"):
        problems.append(f"[imthemousenow.osd].position = '{osd['position']}' is not top, center or bottom")
    for field in ("ms", "fade_ms", "size"):
        value = osd.get(field)
        if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value < 0):
            problems.append(f"[imthemousenow.osd].{field} = '{value}' is not a positive whole number")
    if isinstance(osd.get("ms"), int) and isinstance(osd.get("fade_ms"), int) and osd["fade_ms"] > osd["ms"]:
        problems.append(f"[imthemousenow.osd].fade_ms ({osd['fade_ms']}) is longer than ms ({osd['ms']})")

    keys = merged.get("general", {}).get("home_row_keys", "")
    if keys and len(keys) != 11:
        problems.append(f"general.home_row_keys is {len(keys)} characters; wl-kbptr requires exactly 11")
    if keys and len(set(keys)) != len(keys):
        problems.append("general.home_row_keys has duplicate characters")

    defaults = merged.get("imthemousenow", {}).get("defaults", {})
    for field, valid in axis_values(merged).items():
        value = defaults.get(field)
        if value is not None and value not in valid:
            problems.append(f"[imthemousenow.defaults].{field} = '{value}' is not one of {sorted(valid)}")
    for section, body in merged.items():
        if is_reserved(section):
            continue
        if not isinstance(body, dict):
            problems.append(f"top-level key '{section}' is not in any section")
    for problem in problems:
        print(f"imthemousenow-config: {problem}", file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"ok: {len(merged.get('mode', {}))} modes, compiles to {compile_config(force=True)}")


# One `MOUSENOW_CFG_*=value` line per setting, for a shell to eval once instead
# of launching this program per lookup. A dotted key becomes the variable name:
# `continuous.guard_ms` -> MOUSENOW_CFG_CONTINUOUS_GUARD_MS. Modes come too, as
# MOUSENOW_CFG_MODE_<NAME>_<FIELD>, because the run loop re-reads them on every
# pass and that was the most expensive lookup of the lot.
def env_name(path: str) -> str:
    return "MOUSENOW_CFG_" + path.replace(".", "_").replace("-", "_").upper()


def flatten(node: dict, prefix: str = "") -> dict:
    out = {}
    for key, value in node.items():
        path = f"{prefix}{key}"
        if isinstance(value, dict):
            out.update(flatten(value, f"{path}."))
        else:
            out[path] = ini_value(value)
    return out


def cmd_env(args):
    merged = settings()
    if not DEFAULTS.is_file():
        die(f"missing shipped defaults: {DEFAULTS}")

    flat = flatten(merged.get("imthemousenow", {}))
    for name, mode in merged.get("mode", {}).items():
        flat.update(flatten(mode, f"mode.{name}."))

    for field, valid in axis_values(merged).items():
        flat[f"valid.{field}"] = " ".join(valid)

    for path, value in sorted(flat.items()):
        print(f"{env_name(path)}={shlex.quote(value)}")


def cmd_path(args):
    for label, path in (
        ("defaults", DEFAULTS),
        ("theme", THEME_CONF),
        ("user", USER_CONF),
        ("compiled", COMPILED),
    ):
        mark = "" if path.is_file() else "   (absent)"
        print(f"{label:9} {path}{mark}")


COMMANDS = {
    "compile": cmd_compile,
    "mode": cmd_mode,
    "modes": cmd_modes,
    "get": cmd_get,
    "opacity": cmd_opacity,
    "env": cmd_env,
    "check": cmd_check,
    "path": cmd_path,
}

if __name__ == "__main__":
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    handler = COMMANDS.get(argv[0])
    if handler is None:
        die(f"unknown subcommand '{argv[0]}'; try --help")
    handler(argv[1:])
