#!/bin/bash
# omarchy:summary=Flash one large word on screen, then fade it out
# omarchy:args=TEXT [--ms N] [--fade-ms N] [--color #rrggbb] [--font NAME] [--size N] [--position top|center|bottom] [--region WxH+X+Y] [--output NAME] [--no-ascii]
#
# Say which ACTION you just switched into, large enough to read without looking
# for it and gone before it is in the way.
#
# The word is drawn the way the Omarchy wordmark is drawn: as block art, in the
# FIGlet font Omarchy sets its own name in, via `omarchy ascii` (or the copy
# install.sh vendors when this Omarchy predates that command). That is a look
# rather than a feature -- a word that cannot be read is worse than a plain one
# -- so every way of failing to produce the art falls back to plain text and the
# announcement still happens: no tool, a label the font has no glyphs for, an
# empty render. `--no-ascii` asks for the plain word outright.
#
# The drawing is qml/osd.qml, run by quickshell -- which is a dependency of the
# `omarchy` package itself, so it is present on every Omarchy machine and this
# feature adds nothing to install. (An earlier version used gtk4-layer-shell,
# which only arrives with applications a user may or may not have.) Quickshell
# owns argv, so parameters are passed as environment variables.
#
# What that QML must get right, and why, is in docs/design-notes.md: an empty
# input region so this cannot swallow the click it is announcing, and no
# keyboard focus so it cannot dismiss the popup being aimed at.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
QML="$SELF_DIR/../qml/osd.qml"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/imthemousenow"
PIDFILE="$RUNTIME/osd.pid"

usage() {
  sed -n '/^# Usage/,/^$/p' "$0" | sed 's/^# \?//'
  cat <<'USAGE'
Usage: imthemousenow-osd TEXT [options]

  --ms N          total time on screen, solid plus fade (default 500)
  --fade-ms N     how much of that is the fade out (default 250)
  --color C       text colour, #rrggbb
  --font NAME     font family
  --size N        font size in px
  --position P    top | center | bottom
  --region R      WxH+X+Y, monitor-relative: place within this box rather than
                  across the whole screen. What window scope passes.
  --output NAME   which monitor the region belongs to
  --no-ascii      plain text, rather than the Omarchy wordmark's block art

One at a time: starting another replaces the one on screen.
USAGE
}

text="" ms=500 fade_ms=250 color="#ffffff" font="sans-serif" size=120 position="top" region="" output="" ascii=1

while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    # What install.sh asks: is everything this needs actually here?
    --self-test)
      command -v quickshell >/dev/null 2>&1 || { echo "imthemousenow-osd: quickshell is not installed" >&2; exit 1; }
      [[ -f $QML ]] || { echo "imthemousenow-osd: missing $QML" >&2; exit 1; }
      echo "imthemousenow-osd: ready"
      exit 0
      ;;
    --ms) ms="${2:?--ms needs a value}"; shift 2 ;;
    --fade-ms) fade_ms="${2:?--fade-ms needs a value}"; shift 2 ;;
    --color) color="${2:?--color needs a value}"; shift 2 ;;
    --font) font="${2:?--font needs a value}"; shift 2 ;;
    --size) size="${2:?--size needs a value}"; shift 2 ;;
    --position) position="${2:?--position needs a value}"; shift 2 ;;
    --region) region="${2:?--region needs a value}"; shift 2 ;;
    --output) output="${2:?--output needs a value}"; shift 2 ;;
    --ascii) ascii=1; shift ;;
    --no-ascii) ascii=0; shift ;;
    -*) echo "imthemousenow-osd: unknown option $1" >&2; exit 2 ;;
    *)
      [[ -z $text ]] || { echo "imthemousenow-osd: only one TEXT" >&2; exit 2; }
      text="$1"; shift
      ;;
  esac
done

[[ -n $text ]] || { usage >&2; exit 2; }
case "$position" in
  top | center | bottom) ;;
  *) echo "imthemousenow-osd: --position is top, center or bottom" >&2; exit 2 ;;
esac
# Rejected here rather than silently ignored in QML, where a malformed box would
# place the word somewhere arbitrary and look like a bug in the positioning.
if [[ -n $region && ! $region =~ ^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$ ]]; then
  echo "imthemousenow-osd: --region must be WxH+X+Y" >&2
  exit 2
fi
# A fade longer than the whole life would never reach zero on screen.
((fade_ms > ms)) && fade_ms=$ms

# The block art, or nothing at all. Every way of failing to draw it leads back
# to the plain word rather than to a blank or a half-written announcement, which
# is why this is a fallback and not a mode.
#
# Letters and spaces only, checked here before the command is asked: the font
# has no digits or punctuation and silently drops what it cannot draw, so a
# label like "2X" would come back as a perfectly good picture of "X". A wrong
# announcement is worse than a plain one, and the tool cannot tell us that in
# its exit status -- it only fails when NOTHING was drawable.
# Omarchy's own omarchy-ascii when this machine has one -- it arrived after
# 4.0.0.alpha, so plenty do not -- and otherwise the copy install.sh vendored
# into the state directory. Resolved here rather than in imthemousenow-lib.sh,
# and deliberately: sourcing the lib loads the whole config and exits if it
# cannot, and an announcement must not be lost over a decoration. This script
# stays standalone.
ascii_cmd() {
  if command -v omarchy-ascii >/dev/null 2>&1; then
    echo omarchy-ascii
  else
    local vendored="${MOUSENOW_STATE_DIR:-$HOME/.local/state/imthemousenow}/bin/omarchy-ascii"
    [[ -x $vendored ]] && echo "$vendored"
  fi
}

# Rendered here rather than in the QML because only the shell can decide whether
# there is art to be had at all. It costs one process and about 18ms for a word
# this short -- once per ACTION switch, not per frame, and small beside the
# quickshell start that follows it.
#
# The one piece of punctuation an announcement uses is the ` + ` between held
# modifiers and the ACTION ("CTRL + ALT + RIGHT"), and the font has no glyph
# for it. So a text with ` + ` in it is drawn a word at a time, and a plus of
# our own, drawn in the font's own blocks, is set between them. The font draws
# every letter from the same top row down (it has no lowercase), so the pieces
# line up row for row once each is padded to the tallest and to its own width.
PLUS_ART=(
  "           "
  "    ███    "
  "    ███    "
  "▄▄▄▄███▄▄▄▄"
  "▀▀▀▀███▀▀▀▀"
  "    ███    "
  "    ███    "
)

# Pieces of art, side by side, with a gap between. Each is one argument, rows
# separated by newlines. Every row comes out the same width, trailing spaces
# and all, so the block is a clean rectangle. (What keeps its rows in column on
# screen is osd.qml laying art out from the left; see there.)
join_art() {
  local piece
  for piece in "$@"; do printf '%s\0' "$piece"; done |
    LC_ALL=C.UTF-8 awk -v RS='\0' -v gap="   " '
      {
        n = split($0, rows, "\n")
        width = 0
        for (r = 1; r <= n; r++) if (length(rows[r]) > width) width = length(rows[r])
        for (r = 1; r <= n; r++) cell[NR, r] = rows[r]
        w[NR] = width; h[NR] = n; if (n > height) height = n; count = NR
      }
      END {
        for (r = 1; r <= height; r++) {
          line = ""
          for (p = 1; p <= count; p++) {
            text = (r <= h[p]) ? cell[p, r] : ""
            line = line (p > 1 ? gap : "") sprintf("%-" w[p] "s", text)
          }
          print line
        }
      }'
}

# The art for one run of letters and spaces, or nothing.
word_art() {
  [[ $1 =~ ^[A-Za-z[:space:]]+$ ]] || return 1
  local out
  out="$("$ascii_bin" "$1" 2>/dev/null || true)"
  # Backstop for anything the check above did not anticipate: art that is all
  # whitespace is a blank announcement.
  [[ -n ${out//[[:space:]]/} ]] || return 1
  printf '%s' "$out"
}

art=""
if ((ascii)) && ascii_bin="$(ascii_cmd)" && [[ -n $ascii_bin ]]; then
  if [[ $text == *" + "* ]]; then
    pieces=() ok=1 rest="$text"
    plus="$(printf '%s\n' "${PLUS_ART[@]}")"
    while :; do
      word="${rest%% + *}"
      if piece="$(word_art "$word")"; then pieces+=("$piece"); else ok=0; break; fi
      [[ $rest == *" + "* ]] || break
      rest="${rest#* + }"
      pieces+=("$plus")
    done
    # A word that cannot be drawn sinks the whole thing to plain text rather
    # than leaving a hole in the announcement.
    ((ok)) && art="$(join_art "${pieces[@]}")"
  else
    piece="$(word_art "$text" || true)"
    [[ -n $piece ]] && art="$(join_art "$piece")"
  fi
fi

# Replace whatever is on screen rather than stacking on top of it: two switches
# in quick succession are normal (`;` cycles), and two words both fading would
# be one unreadable over the other. The runtime directory is the session's own,
# so a reboot clears it for free.
mkdir -p "$RUNTIME"
# The recorded pid is checked to be one of ours before it is signalled: the file
# outlives the process (exec leaves no trap to clean it up), so by the time it is
# read the pid may have been recycled by something else entirely.
if [[ -f $PIDFILE ]]; then
  old="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ $old =~ ^[0-9]+$ ]] && grep -qa "osd.qml" "/proc/$old/cmdline" 2>/dev/null; then
    kill "$old" 2>/dev/null || true
  fi
fi
echo $$ >"$PIDFILE"

# exec, so the pid recorded above is the process that owns the surface.
export MOUSENOW_OSD_TEXT="$text" \
  MOUSENOW_OSD_ART="$art" \
  MOUSENOW_OSD_COLOR="$color" \
  MOUSENOW_OSD_FONT="$font" \
  MOUSENOW_OSD_SIZE="$size" \
  MOUSENOW_OSD_MS="$ms" \
  MOUSENOW_OSD_FADE_MS="$fade_ms" \
  MOUSENOW_OSD_POSITION="$position" \
  MOUSENOW_OSD_REGION="$region" \
  MOUSENOW_OSD_OUTPUT="$output"
exec quickshell --no-color -p "$QML"
