#!/bin/bash
# omarchy:summary=Emit wl-kbptr floating regions (wxh+x+y) for the focused output
# omarchy:args=[--scope screen|active-window|workspace] [--source windows|merge] [--exclude ADDRESS]
set -euo pipefail

scope="screen"
source_kind="windows"
exclude=""

while (($#)); do
  case "$1" in
    --scope) scope="${2:?}"; shift 2 ;;
    --scope=*) scope="${1#*=}"; shift ;;
    --source) source_kind="${2:?}"; shift 2 ;;
    --source=*) source_kind="${1#*=}"; shift ;;
    --exclude) exclude="${2:?}"; shift 2 ;;
    --exclude=*) exclude="${1#*=}"; shift ;;
    -h | --help)
      echo "Usage: imthemousenow-regions [--scope ...] [--source windows|merge] [--exclude ADDRESS]"
      exit 0
      ;;
    *) echo "imthemousenow-regions: unknown option $1" >&2; exit 2 ;;
  esac
done

# Focused monitor origin: regions must be output-relative. Its workspaces come
# along because "on this monitor" is not the same as "on screen": every window
# on every workspace of a monitor keeps its geometry, so a label per window on
# the monitor labels windows you cannot see, on top of the ones you can.
read -r mon_x mon_y mon_id mon_ws mon_special < <(hyprctl -j monitors | jq -r '
  .[] | select(.focused) | [.x, .y, .id, .activeWorkspace.id, .specialWorkspace.id] | @tsv')

# Windows on screen on the focused monitor, topmost first. That is its active
# workspace, plus its special workspace when one is open -- a scratchpad that
# is up is as clickable as anything else, and one that is not is not there at
# all. `specialWorkspace.id` is 0 when none is open; special ids are negative,
# so it can never match a real workspace by accident.
windows() {
  hyprctl -j clients | jq -r --argjson mon "$mon_id" --argjson mx "$mon_x" --argjson my "$mon_y" \
    --argjson ws "$mon_ws" --argjson special "$mon_special" --arg exclude "$exclude" '
    [ .[]
      | select(.monitor == $mon)
      | select($exclude == "" or .address != $exclude)
      | select(.hidden == false)
      | select(.mapped == true)
      | select(.workspace.id == $ws or ($special != 0 and .workspace.id == $special))
      | select(.size[0] > 8 and .size[1] > 8)
    ]
    | sort_by(-.focusHistoryID)
    | .[]
    | "\(.size[0])x\(.size[1])+\(.at[0] - $mx)+\(.at[1] - $my)"
  '
}

case "$source_kind" in
  windows | merge) windows ;;
  *) echo "imthemousenow-regions: unknown source '$source_kind'" >&2; exit 2 ;;
esac
