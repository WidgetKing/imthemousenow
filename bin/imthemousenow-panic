#!/bin/bash
# omarchy:summary=Dismiss any pointer overlay, then run Omarchy's Ctrl+Alt+Delete action
#
# Ctrl+Alt+Delete is what people reach for when the screen stops responding, so
# it is the right place to guarantee a way out of a stuck wl-kbptr overlay --
# Hyprland keybindings still fire while wl-kbptr holds the keyboard.
#
# This must never swallow Omarchy's own action: the overlay is closed first,
# then the default runs regardless of what happened above.
set -uo pipefail

# Omarchy's stock CTRL + ALT + DELETE action. Override in the environment if
# Omarchy ever changes it, or to chain something else.
DEFAULT_ACTION="${MOUSENOW_PANIC_ACTION:-omarchy-hyprland-window-close-all}"

# The ordinary way out, which also clears the session state a crashed run
# would otherwise leave behind.
imthemousenow-steer stop >/dev/null 2>&1 || true

# ...and again by hand, because a panic key exists precisely for the times the
# ordinary way did not work. Both are idempotent. The submap matters most: one
# left active would make `;` do nothing everywhere.
pkill -x wl-kbptr >/dev/null 2>&1 || true
hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true

if command -v "${DEFAULT_ACTION%% *}" >/dev/null 2>&1; then
  exec $DEFAULT_ACTION
fi

# The default action is gone (renamed upstream?). Say so rather than failing
# silently -- the overlay is already closed, which is the urgent half.
command -v omarchy-notification-send >/dev/null 2>&1 &&
  omarchy-notification-send -u critical "I'm the mouse now" \
    "Pointer overlay closed, but '$DEFAULT_ACTION' was not found. Check the imthemousenow keybindings."
exit 0
