#!/bin/bash
# omarchy:summary=Steer the pointer overlay that is already up
# omarchy:args=action <a> | scope | mode | workspace <n|±n> | monitor <±n> | stop
#
# wl-kbptr grabs the keyboard, so nothing typed at an overlay can reach the
# process that launched it. The keys that change an overlay are compositor
# bindings instead -- registered in hypr/imthemousenow.lua, live only for the
# submap an overlay is in -- and every one of them runs this script.
#
# Each verb writes what changed into the session and asks the run loop to
# rebuild the overlay around it. None of them launch anything: if no overlay is
# up, they are no-ops. `imthemousenow` is the launcher; this is the steering.
set -euo pipefail

LIB_DIR="${MOUSENOW_PLUGIN_DIR:-$HOME/.local/share/imthemousenow}/bin"
[[ -f $LIB_DIR/imthemousenow-lib.sh ]] || LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=imthemousenow-lib.sh
source "$LIB_DIR/imthemousenow-lib.sh"
# shellcheck source=imthemousenow-session.sh
source "$LIB_DIR/imthemousenow-session.sh"

usage() {
  cat <<EOF
Usage: imthemousenow-steer <verb> [value]

  action <a>     switch ACTION to left-click|right-click|move|drag|hold, or back
  scope          flip SCOPE between window and monitor
  mode           flip MODE between hints and grid
  lifetime       flip LIFETIME between single and continuous
  modkey <ctrl|alt|shift|super> <left|right>
                 a bare modifier tap: on the command side, the axis it flips;
                 on the modifier side (keyboard_modifier_side), toggle holding
                 it down for the next press
  arrow <l|r|u|d>  in monitor scope, move the view; in window scope, the window;
                 during a drop, move to the monitor that way
  digit <1-9>    in monitor scope, go to that workspace; in window scope, send
                 the window there; during a drop, nothing
  resize <l|r|u|d>  in window scope, resize the window the overlay is on
  swap           pick another window and swap the focused one with it
  swap-commit    finish that swap with whatever the picker landed on
  swap-cancel    abandon that swap, putting the overlay back as it was
  workspace <n>  go to workspace n, or step by ±n
  monitor <±n>   step the overlay to another monitor
  help           show or hide the key sheet for the overlay that is up
  escape         popup-safe mode only: close the key sheet, or relay Escape
  refresh        rebuild the overlay against the screen as it is now
  stop           close any overlay that is up

These are what the overlay's own keys run. Bound in hypr/imthemousenow.lua.
EOF
}

# One Hyprland dispatch, reporting a refusal instead of swallowing it.
# Hyprland answers a dispatch it could not parse with "error: ..." on stdout
# and still exits 0, so the exit status is not the thing to test.
#   $1  the Lua dispatcher call
#   $2  what to say it could not do
dispatch_checked() {
  local reply
  reply="$(hyprctl dispatch "$1" 2>&1)"
  if [[ $reply == error:* ]]; then
    notify "Could not $2: ${reply#error: }"
    return 1
  fi
}

# Move the view the overlay is drawn over: hl.dsp.focus({ $1 }).
dispatch_focus() {
  dispatch_checked "hl.dsp.focus({$1})" "move the overlay"
}

# Move the window the overlay is drawn over: hl.dsp.window.move({ $1 }).
# `direction` is Hyprland's movewindow, which moves a tiled window through the
# layout and a floating one across the screen -- not swapwindow, which needs
# something to swap with and refuses when there is nothing there.
dispatch_window() {
  # An empty workspace has nothing to move, and window scope has nothing to
  # draw over either; the overlay fell back to the monitor. Do nothing rather
  # than move whatever Hyprland last considered active.
  [[ $(hyprctl -j activewindow | jq -r '.address // "null"') != null ]] || exit 0
  dispatch_checked "hl.dsp.window.move({$1})" "move the window"
}

# Resize the window the overlay is drawn over: hl.dsp.window.resize({ $1 }).
# Same guard as dispatch_window -- with no window there is nothing to resize.
dispatch_window_resize() {
  [[ $(hyprctl -j activewindow | jq -r '.address // "null"') != null ]] || exit 0
  dispatch_checked "hl.dsp.window.resize({$1})" "resize the window"
}

# A swap starts from the window the overlay is drawn over, so monitor scope has
# no origin to offer -- the mirror image of require_monitor_scope.
require_window_scope() {
  [[ $(session_get scope) == window ]] || exit 0
}

# Every window a swap may land on: what the picker labels, and what the pointer
# is looked up in afterwards. These two must agree exactly or the pointer names
# a window that was never offered, so this is imthemousenow-regions' filter --
# on screen on the focused monitor, scratchpad included only while it is up --
# in layout coordinates, which is what the pointer is in.
#   $1  the window the swap started from, left out: it is not offered as a
#       label, so it must not be findable under the pointer either.
swap_candidates() {
  local origin="${1:-}"
  local mon ws special
  read -r mon ws special < <(hyprctl -j monitors | jq -r '
    .[] | select(.focused) | [.id, .activeWorkspace.id, .specialWorkspace.id] | @tsv')
  hyprctl -j clients | jq --argjson mon "$mon" --argjson ws "$ws" --argjson special "$special" \
    --arg origin "$origin" '
    [ .[]
      | select(.monitor == $mon)
      | select($origin == "" or .address != $origin)
      | select(.hidden == false)
      | select(.mapped == true)
      | select(.workspace.id == $ws or ($special != 0 and .workspace.id == $special))
      | select(.size[0] > 8 and .size[1] > 8)
    ]'
}

# Is there anything at all to swap with, anywhere on the desk? The picker can
# now be walked from monitor to monitor, so "nothing to swap with" is a question
# about every screen rather than only the one the overlay is on -- the same
# filter as swap_candidates, run without the monitor restriction.
#   $1  the window the swap would start from, which is not a candidate
swap_has_candidates() {
  local live
  live="$(hyprctl -j monitors | jq -c '[.[] | .activeWorkspace.id, .specialWorkspace.id]')"
  (($(hyprctl -j clients | jq -r --argjson live "$live" --arg origin "$1" '
    [ .[]
      | select(.address != $origin)
      | select(.hidden == false)
      | select(.mapped == true)
      | select([.workspace.id] | inside($live))
      | select(.size[0] > 8 and .size[1] > 8)
    ] | length') > 0))
}

# Walk the picker to the monitor that lies in direction $1. The overlay follows
# the focus -- imthemousenow-regions labels the focused monitor, and
# swap_candidates reads the same one -- so moving the focus is the whole of it.
# Which window the swap started from is held in `swap-from`, not in the focus,
# so taking the focus along cannot lose it.
swap_to_monitor() {
  local here next
  here="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
  next="$(monitor_in_direction "$here" "$1")"
  # Nothing that way: the edge of the desk is not an error, and a relaunch
  # that lands where it started is a flicker for nothing.
  [[ -n $next && $next != "$here" ]] || exit 0
  dispatch_focus "monitor=\"$next\"" || exit 0
  session_relaunch geometry
  exit 0
}

# Put back the mode, scope and action the picker borrowed, and forget the swap.
# Both endings do this and nothing else may depend on the order, so it is one
# function rather than two copies that drift.
swap_restore_axes() {
  local rmode rscope raction
  read -r rmode rscope raction <<<"$(session_get swap-restore)"
  session_clear swap-from
  session_clear swap-restore
  session_set mode "$rmode"
  session_set scope "$rscope"
  session_set action "$raction"
}

# Flip one of the axes a bare command-side modifier tap flips: SCOPE, MODE or
# LIFETIME. SCOPE and MODE change what the overlay IS, so the run loop re-reads
# both every pass and the overlay is put back up around the new one. LIFETIME
# changes only what happens after the next selection, which the loop also
# reads back, so there is nothing to rebuild.
#
# A modifier release also ends a combo like `:` (SHIFT + SEMICOLON). Hyprland
# may or may not suppress the release bind in that case, so do not rely on it:
# any other bind of ours firing a moment ago means this release finished a
# chord and is not a tap.
flip_axis() {
  local axis="$1" next
  session_recent_bind "$(setting switch.tap_debounce_ms)" && exit 0
  # No overlay, nothing to switch.
  session_has "$axis" || exit 0
  case "$axis" in
    scope) [[ $(session_get scope) == monitor ]] && next="window" || next="monitor" ;;
    mode) [[ $(session_get mode) == grid ]] && next="hints" || next="grid" ;;
    lifetime) [[ $(session_get lifetime) == continuous ]] && next="single" || next="continuous" ;;
  esac
  session_set "$axis" "$next"
  if [[ $axis == lifetime ]]; then
    # Nothing on screen changes, so the word is the only way to know the tap
    # landed -- in the colour of the overlay it applies to.
    osd_word "$next" "$(session_get scope)" "$(setting "action.$(session_get action).color")"
    return 0
  fi
  session_relaunch geometry
}

# Moving the view under the overlay is meaningless in window scope -- the
# overlay is tied to one window there -- so it is a no-op rather than a
# surprise.
require_monitor_scope() {
  [[ $(session_get scope) == monitor ]] || exit 0
}

# The drop pass of a drag holds one end of a path and is aimed at the other.
# Every key that would move the world under it -- a workspace, the focus, a
# window -- is a key that moves what you are aiming at while you aim, so the
# whole group is a no-op there. The arrows are the exception, and they mean
# something else entirely: see `arrow`.
require_no_drop() {
  session_has drag-anchor && exit 0
}

# Move the drop pass to the monitor that lies in direction $1, and take the
# focus with it. The focus matters because what the overlay is made of follows
# it: imthemousenow-regions labels windows on the focused monitor, so a drop
# overlay on one screen built from another screen's windows would label things
# that are not there.
drop_to_monitor() {
  local here next
  here="$(session_get drop-monitor)"
  [[ -n $here ]] || read -r here _ _ < <(session_get drag-anchor)
  next="$(monitor_in_direction "$here" "$1")"
  # Nothing that way: the edge of the desk is not an error, and a relaunch
  # that lands where it started is a flicker for nothing.
  [[ -n $next && $next != "$here" ]] || exit 0
  session_set drop-monitor "$next"
  dispatch_focus "monitor=\"$next\"" || exit 0
  session_relaunch geometry
  exit 0
}

# Everything but `stop` acts on a run that is up. With none, do nothing at all
# -- not even stamp a bind -- so a stray invocation leaves no state behind.
[[ ${1:-} =~ ^(stop|-h|--help)$ ]] || session_active || exit 0

verb="${1:-}"
[[ -n $verb ]] || { usage; exit 2; }
shift || true

case "$verb" in
  -h | --help)
    usage
    exit 0
    ;;

  action)
    # Bound to `;` (right-click) and `:` (move). wl-kbptr cannot be
    # reconfigured once running, so switching ACTION means tearing the overlay
    # down and putting it back up: record the new action, ask for a relaunch,
    # and the loop puts it back rather than exiting.
    target="${1:-right-click}"
    now="$(session_get action)"
    base="$(session_get base-action)"
    # An ACTION that needs a patched wl-kbptr is refused here for the reason the
    # launcher refuses the chord, and by the same registry: the overlay this
    # switches would be torn down before the binary was ever asked, leaving you
    # aimed at something with nothing holding it. Refused while the answer is
    # still "nothing happened".
    if ! action_supported "$target"; then
      notify "${target^} needs the wl-kbptr this plugin builds; run its install.sh"
      exit 0
    fi
    # Any of `;` `:` `'` `"` abandons a drag that is half-finished, whichever
    # one started it: at this point the pointer has been moved onto something but
    # nothing has been pressed, so there is no press to undo and no state worth
    # carrying into whatever ACTION you asked for instead. The axes the drop
    # pass borrowed go back, and the ACTION asked for is the run's own -- you
    # said "not this", not "and now do that with it".
    if session_has drag-anchor; then
      read -r rest_mode rest_scope <<<"$(session_get drag-restore)"
      [[ -n ${rest_mode:-} ]] && session_set mode "$rest_mode"
      [[ -n ${rest_scope:-} ]] && session_set scope "$rest_scope"
      session_clear drag-anchor
      session_clear drag-restore
      session_clear drop-monitor
      session_stamp_bind
      session_set action "$base"
      osd_action "$base" "$(session_get scope)" "$(session_get modifiers)"
      session_relaunch action
      exit 0
    fi
    # Pressing the same key again goes back to what the chord asked for, so `;`
    # and `:` are each their own undo rather than needing one.
    [[ $now == "$target" ]] && next="$base" || next="$target"
    session_stamp_bind
    # Already there: relaunching would cost a flicker and change nothing.
    [[ $next == "$now" ]] && exit 0
    session_set action "$next"
    # Before the relaunch, not after: the tint on the new overlay is the only
    # other thing that says what changed, and the word should be up by the time
    # the overlay it describes is drawn.
    osd_action "$next" "$(session_get scope)" "$(session_get modifiers)"
    session_relaunch action
    ;;

  scope | mode | lifetime)
    flip_axis "$verb"
    ;;

  modkey)
    # Bound to a bare tap of every modifier on both sides of the keyboard. The
    # lua cannot tell the two sides' jobs apart -- it reads no config, by
    # choice -- so it says which key and which side, and the side is decided
    # here against keyboard_modifier_side.
    mod="${1:?modkey needs a modifier}"
    side="${2:?modkey needs a side}"
    if [[ $side != "$(setting keyboard_modifier_side)" ]]; then
      # The command side. SUPER has no axis yet, and is left free for one.
      case "$mod" in
        shift) flip_axis scope ;;
        alt) flip_axis mode ;;
        ctrl) flip_axis lifetime ;;
      esac
      exit 0
    fi

    # The modifier side: switch one modifier in or out of what the next press
    # holds down. Same debounce as a command tap, for the same reason -- the
    # right SHIFT released after a `:` typed with it ended a chord.
    session_recent_bind "$(setting switch.tap_debounce_ms)" && exit 0
    act="$(session_get action)"
    # An ACTION that presses nothing has nothing to hold a modifier around:
    # move, and the swap picker, which is move. Nothing happens rather than a
    # word that promises a Ctrl click that is not coming.
    [[ $(setting "action.$act.modifiers") == true ]] || exit 0
    if ! has_modifiers; then
      notify "Holding modifiers needs the wl-kbptr this plugin builds; run its install.sh"
      exit 0
    fi
    next="$(modifiers_toggle "$(session_get modifiers)" "$mod")"
    if [[ -n $next ]]; then session_set modifiers "$next"; else session_clear modifiers; fi
    # The drop pass is drawn over a whole monitor whatever SCOPE says, so its
    # word goes there too, as it did when the drop pass opened.
    scope_now="$(session_get scope)"
    session_has drag-anchor && scope_now=monitor
    osd_action "$act" "$scope_now" "$next"
    # An overlay that clicks reads the session's file at the click, when the
    # build can; an older one was told its modifiers at launch, so a change
    # means launching it again. One that does not click -- either half of a
    # drag, a hold -- reads them when it presses, after the overlay is gone,
    # and is left alone: nothing about it has changed yet.
    [[ -n $(setting "action.$act.button") ]] && ! has_modifiers_file && session_relaunch modifiers
    ;;

  resize)
    # Bound to `-` `=` `_` `+`, which is where Omarchy already keeps resizing:
    # SUPER + those four keys resize the focused window, and inside the overlay
    # the same four keys do the same thing to the window the overlay is drawn
    # over, including the directions -- `-` and `=` grow and shrink on the
    # horizontal edge, `_` and `+` on the vertical one. Window scope only: over
    # a whole monitor there is no one window the overlay is about, the way
    # there is none for Tab.
    #
    # `_` and `+` are SHIFT chords, and releasing that SHIFT is also a SCOPE
    # tap -- session_stamp_bind is what tells the tap it was the tail of a
    # chord, exactly as it does for `:`.
    value="${1:?resize needs a direction}"
    step="$(setting resize.step)"
    session_stamp_bind
    require_window_scope
    case "$value" in
      l) delta="x=-$step, y=0" ;;
      r) delta="x=$step, y=0" ;;
      u) delta="x=0, y=-$step" ;;
      d) delta="x=0, y=$step" ;;
      *) die "unknown resize direction '$value'" ;;
    esac
    dispatch_window_resize "$delta, relative=true" || exit 0
    session_relaunch geometry
    ;;

  swap)
    # Bound to Tab, in window scope: swap the window the overlay is drawn over
    # with another one, chosen the same way anything else here is chosen -- a
    # labelled overlay. There is no "pick a window" primitive to call, so the
    # picker IS an overlay: mode `windows` labels one region per window, ACTION
    # `move` lands the pointer on the one you pick without clicking it, and
    # `swap-commit` reads the pointer back. The axes it borrows are put back
    # when it commits, so the swap is a detour rather than a new state.
    require_window_scope
    # Not during a drag. The drop pass is drawn over a whole monitor and is
    # holding one end of a path; a detour that moves windows around underneath
    # it would leave the other end pointing at where something used to be.
    session_has drag-anchor && exit 0
    origin="$(hyprctl -j activewindow | jq -r '.address // ""')"
    # Nothing focused, or nothing to swap with: an overlay that can only be
    # cancelled is worse than a key that did nothing.
    [[ -n $origin ]] || exit 0
    swap_has_candidates "$origin" || exit 0
    session_stamp_bind
    session_set swap-from "$origin"
    session_set swap-restore "$(session_get mode) $(session_get scope) $(session_get action)"
    session_set mode windows
    session_set scope monitor
    session_set action move
    session_relaunch geometry
    ;;

  swap-commit)
    # Run by the run loop, not by a key: it is the half of `swap` that can only
    # happen once the picker has been used. Whatever else it does, it must put
    # the borrowed axes back, so a failed swap leaves the overlay where it was
    # rather than stranded in the picker.
    session_has swap-from || exit 0
    origin="$(session_get swap-from)"
    swap_restore_axes

    # Which window the pointer landed on. The pointer is the answer because
    # ACTION move is what put it there; wl-kbptr does not report the region it
    # chose. Topmost first, so overlapping windows resolve the way they look.
    read -r cx cy < <(hyprctl -j cursorpos | jq -r '[.x, .y] | @tsv')
    target="$(swap_candidates "$origin" | jq -r --argjson x "$cx" --argjson y "$cy" '
      [ .[]
        | select(.at[0] <= $x and $x < .at[0] + .size[0])
        | select(.at[1] <= $y and $y < .at[1] + .size[1])
      ]
      | sort_by(.focusHistoryID)
      | .[0].address // ""
    ')"
    # Cancelled, landed on the desktop, or landed back on the window it started
    # from: the axes are already restored, so there is nothing left to do.
    [[ -n $target && $target != "$origin" ]] || exit 0

    # swap acts on the active window, and the pointer may have taken the focus
    # with it, so say which window is swapping rather than assuming.
    dispatch_checked "hl.dsp.focus({window=\"address:$origin\"})" "find the window to swap" || exit 0
    dispatch_checked "hl.dsp.window.swap({target=\"address:$target\"})" "swap the windows" || exit 0
    ;;

  swap-cancel)
    # Escape out of the picker. The pointer is wherever it already was, which
    # names a window as convincingly as a real pick does and means nothing at
    # all -- so a cancelled swap must never reach swap-commit. It restores the
    # axes and stops there.
    session_has swap-from || exit 0
    swap_restore_axes
    ;;

  help)
    # Bound to F1 and `?`. A toggle, because the key that opens the sheet is
    # the one a hand is already on when it wants it gone.
    #
    # The sheet REPLACES the overlay rather than sitting on top of it. In the
    # ordinary submap it has to: it reads its own keyboard, and wl-kbptr holds
    # a grab that nothing else may take while it is up. So this asks for a
    # relaunch the way every other key here does, and the run loop shows the
    # sheet in the gap -- when it is dismissed the overlay comes back exactly
    # as it was, same mode, same scope, same action. Popup-safe mode keeps the
    # same shape rather than growing a second one: there the overlay takes no
    # keyboard either way, but an overlay left up behind a sheet is labels
    # under a panel of text.
    if help_showing; then
      help_stop
      exit 0
    fi
    session_stamp_bind
    session_relaunch help
    ;;

  escape)
    # Popup-safe mode only, where Escape is a compositor binding rather than a
    # key wl-kbptr reads -- see RELAY_KEYS in hypr/imthemousenow.lua. With the
    # sheet up there is no overlay to cancel and the sheet cannot read its own
    # keyboard (taking it is what closes the popup the mode exists to keep
    # open), so Escape has to arrive here. Otherwise it is the relay it always
    # was, and wl-kbptr cancels exactly as it did before.
    if help_showing; then
      help_stop
      exit 0
    fi
    echo Escape >>"$SESSION_DIR/keys" 2>/dev/null || true
    ;;

  refresh)
    # Bound to F5. Everything the overlay draws is measured once, when it
    # launches: the window geometry, and in hints mode the regions detected in
    # that frame. Anything that moves afterwards -- a page that scrolled, a
    # window that resized, a dialog that opened -- leaves the labels pointing
    # at where things used to be. This is the reload: same MODE, SCOPE and
    # ACTION, measured again. The loop recomputes geometry and regions before
    # every launch, so asking for a relaunch is the whole implementation.
    session_stamp_bind
    session_relaunch refresh
    ;;

  arrow | digit)
    # The digits and the arrow keys mean "the thing on the other side of this
    # key", and what that is depends on what the overlay is drawn over. In
    # monitor scope the overlay is the whole screen, so they move the screen
    # underneath it -- another workspace, another monitor. In window scope the
    # overlay IS one window, and moving the view would be moving away from the
    # thing being aimed at, so the same keys move that window instead: exactly
    # what SUPER + an arrow and SUPER + SHIFT + a digit do outside the overlay.
    # Either way the overlay is rebuilt around where things ended up.
    value="${1:?$verb needs a value}"
    session_stamp_bind
    # A drop pass reads both of these differently, and the reason is the
    # confusion they cause otherwise: in the middle of a drag, "left" is much
    # more likely to mean the screen on the left than the workspace before this
    # one, and a key that could mean either leaves you unsure which one you
    # just did. So during a drop the arrows only ever change monitor, and the
    # digits -- which can only mean a workspace -- do nothing at all.
    if session_has drag-anchor; then
      [[ $verb == arrow ]] || exit 0
      drop_to_monitor "$value"
    fi
    # The picker reads them the same way, and for the same reason: it is drawn
    # over one whole monitor and the window it is looking for may be on another
    # screen. So the arrows walk the picker across the desk, and the digits --
    # which could only mean a workspace, and would swap the labels out from
    # under a half-made choice -- do nothing at all.
    if session_has swap-from; then
      [[ $verb == arrow ]] || exit 0
      swap_to_monitor "$value"
    fi
    if [[ $(session_get scope) == window ]]; then
      if [[ $verb == arrow ]]; then
        dispatch_window "direction=\"$value\"" || exit 0
      else
        dispatch_window "workspace=\"$value\"" || exit 0
      fi
    else
      case "$verb:$value" in
        arrow:l) dispatch_focus "workspace=\"-1\"" || exit 0 ;;
        arrow:r) dispatch_focus "workspace=\"+1\"" || exit 0 ;;
        arrow:u) dispatch_focus "monitor=\"-1\"" || exit 0 ;;
        arrow:d) dispatch_focus "monitor=\"+1\"" || exit 0 ;;
        digit:*) dispatch_focus "workspace=\"$value\"" || exit 0 ;;
        *) die "unknown $verb '$value'" ;;
      esac
    fi
    session_relaunch geometry
    ;;

  workspace)
    # Bound to the digits and to LEFT/RIGHT. Omarchy's Hyprland uses the Lua
    # config parser, so a dispatch is Lua: the bare `hyprctl dispatch workspace
    # 5` form does not parse at all. hl.dsp.focus takes an absolute id or a
    # signed relative step, which is every move these keys need.
    session_stamp_bind
    require_no_drop
    require_monitor_scope
    dispatch_focus "workspace=\"${1:?workspace needs a value}\""
    session_relaunch geometry
    ;;

  monitor)
    session_stamp_bind
    # Unlike the workspace keys, this one is not wrong during a drop -- it is
    # what the arrows now do -- but it steps by index, and the drop pass is
    # steered by direction and remembers where it is. Let `arrow` own it.
    require_no_drop
    require_monitor_scope
    # One monitor means there is nowhere to go, and a relaunch that lands
    # exactly where it started is a flicker for nothing.
    (($(hyprctl -j monitors | jq -r 'length') > 1)) || exit 0
    dispatch_focus "monitor=\"${1:?monitor needs a value}\""
    session_relaunch geometry
    ;;

  stop)
    # Escape hatch: close any overlay that is up, including one left behind by
    # a crash. Safe to run when nothing is running.
    pkill -x wl-kbptr >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.submap(\"reset\")" >/dev/null 2>&1 || true
    session_end
    ;;

  *) die "unknown verb '$verb'; try --help" ;;
esac

exit 0
