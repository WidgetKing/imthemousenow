#!/bin/bash
# imthemousenow font-set hook.
#
# No work to do: imthemousenow reads `omarchy-font-current` at launch and
# passes it as -o <mode>.label_font_family, and wl-kbptr re-reads its config on
# every invocation. The hook exists so `omarchy font set` proves the wiring,
# and as the place to hang work if the font ever needs baking into the config.
exit 0
